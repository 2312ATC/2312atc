---
import HeaderLink from './HeaderLink.astro';
import NotificationPanel from './NotificationPanel.astro';
import { Image } from 'astro:assets';
import logo from '../assets/images/whiteLogo.png';
---

<header class="site-header">
	<div class="mobile-nav-backdrop" data-nav-backdrop aria-hidden="true"></div>
	<nav aria-label="Main navigation">
		<a class="logo-link" href="/" aria-label="2312 Squadron Air Cadets - Home">
			<span class="logo-shape">
				<Image
					src={logo}
					alt="Royal Air Force Air Cadets 2312 Squadron logo"
					layout="constrained"
					loading="eager"
					fetchpriority="high"
					class="logo-image"
				/>
			</span>
		</a>
		<div id="nav-links" class="internal-links">
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/events">Events</HeaderLink>
			<HeaderLink href="/blog/page/1">News</HeaderLink>
			<HeaderLink href="/whatWeDo">What We Do</HeaderLink>
			<HeaderLink href="/cadets">Cadets</HeaderLink>
			<HeaderLink href="/joinUs" class="nav-join">Join Us</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="nav-end">
			<button
				type="button"
				class="burger icon-control"
				aria-label="Open navigation menu"
				aria-expanded="false"
				aria-controls="nav-links"
			>
				<span class="material-icons" aria-hidden="true">menu</span>
			</button>
			<NotificationPanel />
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background-color: var(--color-raf-navy);
		line-height: 0;
	}

	.site-header::after {
		content: '';
		display: block;
		height: var(--accent-bar);
		background: var(--color-raf-red);
	}

	nav {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		max-width: var(--content-wide);
		margin: 0 auto;
		padding: 0 1rem;
		column-gap: 1rem;
	}

	.logo-link {
		/* Unitless rem counts. Dividing lengths is dropped in Firefox, which removes the slant. */
		--logo-w: 16.25;
		--logo-slant: 3.125;
		--logo-pad-y: 0.3125;
		--logo-img-w: 273;
		--logo-img-h: 184;
		--logo-min-h: 3.5rem;
		--logo-max-h: 12vh;
		--logo-content-w: calc(var(--logo-w) - var(--logo-slant) * 1.5);
		--logo-h: calc(var(--logo-content-w) * var(--logo-img-h) / var(--logo-img-w) + var(--logo-pad-y) * 2);
		--logo-slant-x: calc(var(--logo-slant) / var(--logo-w) * 100%);
		--logo-slant-x-half: calc(var(--logo-slant) / 2 / var(--logo-w) * 100%);
		--logo-pad-top: calc(var(--logo-pad-y) / var(--logo-h) * 100%);

		display: block;
		/* Scale the whole parallelogram together. A fixed slant with a shorter
		   box steepens the shear and lets the artwork cross the clipped edge. */
		width: clamp(
			calc(var(--logo-min-h) * var(--logo-w) / var(--logo-h)),
			calc(var(--logo-max-h) * var(--logo-w) / var(--logo-h)),
			calc(var(--logo-w) * 1rem)
		);
		max-width: 100%;
		min-width: 0;
		flex-shrink: 1;
	}

	.logo-shape {
		display: block;
		position: relative;
		width: 100%;
		aspect-ratio: calc(var(--logo-w) / var(--logo-h));
		background-color: var(--color-white);
		clip-path: polygon(
			var(--logo-slant-x) 0,
			100% 0,
			calc(100% - var(--logo-slant-x)) 100%,
			0 100%
		);
	}

	.logo-image {
		position: absolute;
		top: var(--logo-pad-top);
		left: var(--logo-slant-x-half);
		width: calc(100% - var(--logo-slant-x) - var(--logo-slant-x-half));
		height: calc(100% - var(--logo-pad-top) * 2);
		max-width: none;
		max-height: none;
		object-fit: contain;
	}

	.nav-end {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
		margin-left: auto;
	}

	.internal-links {
		min-width: 0;
	}

	.burger {
		display: none;
	}

	.internal-links {
		display: inline-flex;
		flex: 1;
		justify-content: flex-end;
		align-items: center;
		gap: 0.25rem;
		line-height: 1.7;
		flex-wrap: wrap;
	}

	/* "Join Us" gets a highlighted treatment */
	.internal-links :global(.nav-join a) {
		background: var(--color-raf-red);
		border-radius: var(--radius-sm);
		padding: 0.25rem 0.75rem;
	}

	.mobile-nav-backdrop {
		display: none;
	}

	@media (max-width: 780px) {
		nav {
			justify-content: space-between;
		}

		.burger {
			display: inline-flex;
		}

		.mobile-nav-backdrop {
			display: block;
			position: fixed;
			z-index: 0;
			top: var(--header-height, var(--header-offset));
			left: 0;
			right: 0;
			bottom: 0;
			background: var(--color-black-45);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.3s ease;
		}

		.mobile-nav-backdrop.open {
			opacity: 1;
			pointer-events: auto;
		}

		.internal-links {
			display: flex;
			flex-direction: column;
			flex-wrap: nowrap;
			justify-content: flex-start;
			align-items: stretch;
			position: fixed;
			z-index: 2;
			top: var(--header-height, var(--header-offset));
			right: 0;
			margin: 0;
			padding-block: 0.5rem;
			padding-inline: 0;
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			visibility: hidden;
			transition:
				max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
				opacity 0.25s ease,
				visibility 0.35s;
			background-color: var(--color-raf-navy);
			box-shadow: var(--shadow-drawer);
			border-radius: 0 0 0 0.5rem;
			pointer-events: none;
		}

		.internal-links.open {
			max-height: min(80vh, 30rem);
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}

		.internal-links :global(.nav-join a) {
			margin: 0;
			border-radius: 0;
		}
	}
</style>

<script>
	const headerEl = document.querySelector<HTMLElement>('.site-header');
	if (!headerEl) throw new Error('Missing .site-header');
	const navLinks = headerEl.querySelector<HTMLElement>('#nav-links');
	const burger = headerEl.querySelector<HTMLButtonElement>('.burger');
	const icon = burger?.querySelector<HTMLElement>('.material-icons');
	const backdrop = headerEl.querySelector<HTMLElement>('[data-nav-backdrop]');

	function syncHeaderHeight() {
		const h = headerEl?.offsetHeight ?? null;
		if (h != null) {
			document.documentElement.style.setProperty('--header-height', `${h}px`);
		}
	}

	function syncNavInert() {
		if (!navLinks) return;
		const mobile = window.matchMedia('(max-width: 780px)').matches;
		const open = navLinks.classList.contains('open');
		if (mobile && !open) {
			navLinks.setAttribute('inert', '');
		} else {
			navLinks.removeAttribute('inert');
		}
	}

	function setNavOpen(open: boolean) {
		if (!navLinks || !burger || !icon) return;
		navLinks.classList.toggle('open', open);
		syncNavInert();
		backdrop?.classList.toggle('open', open);
		if (backdrop) backdrop.setAttribute('aria-hidden', open ? 'false' : 'true');
		burger.setAttribute('aria-expanded', open ? 'true' : 'false');
		burger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
		icon.textContent = open ? 'close' : 'menu';
		document.body.style.overflow = open ? 'hidden' : '';
	}

	burger?.addEventListener('click', () => {
		const isOpen = navLinks?.classList.contains('open') ?? false;
		syncHeaderHeight();
		setNavOpen(!isOpen);
	});

	backdrop?.addEventListener('click', () => setNavOpen(false));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && navLinks?.classList.contains('open')) {
			setNavOpen(false);
			burger?.focus();
		}
	});

	syncHeaderHeight();
	syncNavInert();
	window.addEventListener('resize', () => {
		syncHeaderHeight();
		const mobile = window.matchMedia('(max-width: 780px)').matches;
		if (!mobile && navLinks?.classList.contains('open')) {
			setNavOpen(false);
		} else {
			syncNavInert();
		}
	});
</script>
