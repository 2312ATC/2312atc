<script is:inline>
(function () {
  var KEY = '2312-preview-gate';
  var PASSWORD = 'tavistock2312';

  // Hide the page immediately before first paint to prevent content flash
  if (localStorage.getItem(KEY) !== 'true') {
    document.documentElement.style.visibility = 'hidden';
  }

  function unlock() {
    localStorage.setItem(KEY, 'true');
    document.documentElement.style.visibility = '';
    var gate = document.getElementById('preview-gate');
    if (gate) gate.remove();
  }

  document.addEventListener('DOMContentLoaded', function () {
    if (localStorage.getItem(KEY) === 'true') {
      document.documentElement.style.visibility = '';
      return;
    }

    // Build the overlay
    var gate = document.createElement('div');
    gate.id = 'preview-gate';
    gate.setAttribute('role', 'dialog');
    gate.setAttribute('aria-modal', 'true');
    gate.setAttribute('aria-label', 'Preview access');
    gate.innerHTML = [
      '<div class="pg-box">',
        '<div class="pg-logo-wrap">',
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pg-lock-icon"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
        '</div>',
        '<p class="pg-eyebrow">2312 Squadron Air Cadets</p>',
        '<h1 class="pg-title">Preview Access</h1>',
        '<p class="pg-desc">This site is currently under construction. Please enter the preview password to continue.</p>',
        '<form id="pg-form" novalidate>',
          '<label for="pg-input" class="pg-label">Password</label>',
          '<div class="pg-input-row">',
            '<input id="pg-input" type="password" class="pg-input" autocomplete="current-password" placeholder="Enter password" />',
            '<button type="submit" class="pg-btn">Enter</button>',
          '</div>',
          '<p id="pg-error" class="pg-error" aria-live="assertive" hidden>Incorrect password - please try again.</p>',
        '</form>',
      '</div>',
    ].join('');

    // Styles injected inline so they work before any CSS bundle loads
    var style = document.createElement('style');
    style.textContent = [
      '#preview-gate{',
        'position:fixed;inset:0;z-index:99999;',
        'background:linear-gradient(135deg,var(--color-raf-navy) 0%,#003c71 100%);',
        'display:flex;align-items:center;justify-content:center;',
        'padding:1.5rem;',
        'font-family:var(--font-sans);',
      '}',
      '.pg-box{',
        'background:var(--color-white);border-radius: var(--radius-xl);',
        'padding:2.5rem 2rem;width:100%;max-width:420px;',
        'text-align:center;box-shadow:0 24px 64px var(--color-black-40);',
        'border-top:5px solid var(--color-raf-red);',
      '}',
      '.pg-logo-wrap{',
        'width:3.5rem;height:3.5rem;border-radius:50%;',
        'background:var(--color-raf-navy);display:flex;align-items:center;',
        'justify-content:center;margin:0 auto 1rem;',
      '}',
      '.pg-lock-icon{width:1.5rem;height:1.5rem;color:var(--color-white);stroke:var(--color-white);}',
      '.pg-eyebrow{font-size:0.75rem;font-weight: var(--font-weight-bold);letter-spacing: var(--tracking-caps);text-transform:uppercase;color:var(--color-raf-red);margin:0 0 0.4rem;}',
      '.pg-title{font-size:1.6rem;font-weight: var(--font-weight-extrabold);color:var(--color-raf-navy);margin:0 0 0.75rem;}',
      '.pg-desc{font-size:0.92rem;color:#4b5563;line-height:1.55;margin:0 0 1.5rem;}',
      '.pg-label{display:block;text-align:left;font-size:0.8rem;font-weight: var(--font-weight-bold);color:#374151;margin-bottom:0.4rem;text-transform:uppercase;letter-spacing: var(--tracking-meta);}',
      '.pg-input-row{display:flex;gap:0.5rem;}',
      '.pg-input{',
        'flex:1;padding:0.65rem 0.9rem;border:2px solid #d1d5db;border-radius: var(--radius-md);',
        'font-family:inherit;font-size:1rem;outline:none;transition:border-color var(--duration-fast);',
      '}',
      '.pg-input:focus{border-color:var(--color-raf-navy);}',
      '.pg-btn{',
        'padding:0.65rem 1.25rem;background:var(--color-raf-navy);color:var(--color-white);border:none;border-radius: var(--radius-md);',
        'font-family:inherit;font-weight: var(--font-weight-bold);font-size:1rem;cursor:pointer;',
        'transition:background var(--duration-fast);white-space:nowrap;',
      '}',
      '.pg-btn:hover{background:var(--color-raf-red);}',
      '.pg-btn:focus-visible{outline: var(--focus-ring);outline-offset: var(--focus-offset-tight);}',
      '.pg-error{font-size:0.85rem;color:var(--color-raf-red);margin:0.6rem 0 0;font-weight: var(--font-weight-semibold);}',
    ].join('');
    document.head.appendChild(style);

    document.body.appendChild(gate);
    document.documentElement.style.visibility = '';
    document.getElementById('pg-input').focus();

    document.getElementById('pg-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var val = document.getElementById('pg-input').value;
      if (val === PASSWORD) {
        unlock();
      } else {
        var err = document.getElementById('pg-error');
        err.hidden = false;
        document.getElementById('pg-input').value = '';
        document.getElementById('pg-input').focus();
      }
    });
  });
})();
</script>
