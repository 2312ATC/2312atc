---
const buildId = import.meta.env.PUBLIC_BUILD_ID ?? '';
---

<div class="notif-panel" data-notif-panel data-build-id={buildId}>
	<button
		type="button"
		class="notif-bell"
		aria-label="Notifications"
		aria-expanded="false"
		aria-controls="notif-modal"
	>
		<span class="material-icons" aria-hidden="true">notifications</span>
	</button>

	<div class="notif-backdrop" data-notif-backdrop hidden aria-hidden="true"></div>

	<div
		id="notif-modal"
		class="notif-modal"
		role="dialog"
		aria-modal="true"
		aria-label="Notifications"
		hidden
	>
		<div class="notif-modal-header">
			<h2 class="notif-modal-title">Notifications</h2>
			<button type="button" class="notif-modal-close" aria-label="Close notifications">
				<span class="material-icons" aria-hidden="true">close</span>
			</button>
		</div>
		<div class="notif-modal-body">
			<ul class="notif-list" data-notif-list></ul>
			<p class="notif-empty" data-notif-empty hidden>No notifications right now.</p>
		</div>
	</div>
</div>

<style>
	.notif-panel {
		position: relative;
		display: flex;
		align-items: center;
		line-height: 1;
	}

	.notif-bell {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin: 0;
		padding: 0.4rem;
		border: 2px solid rgba(255, 255, 255, 0.3);
		border-radius: 6px;
		background: transparent;
		color: #fff;
		cursor: pointer;
		flex-shrink: 0;
	}

	.notif-bell:focus-visible {
		outline: 3px solid var(--rafRed);
		outline-offset: 2px;
	}

	.notif-bell .material-icons {
		font-size: 1.5rem;
	}

	.notif-backdrop {
		position: fixed;
		z-index: 29;
		inset: 0;
		top: var(--header-height, 4.5rem);
		background: rgba(0, 0, 0, 0.45);
	}

	.notif-modal {
		position: fixed;
		z-index: 30;
		top: var(--header-height, 4.5rem);
		right: 0;
		width: min(100%, 24rem);
		max-height: calc(100vh - var(--header-height, 4.5rem));
		display: flex;
		flex-direction: column;
		background: #fff;
		box-shadow: -4px 12px 28px rgba(0, 0, 0, 0.25);
		color: rgb(var(--gray-dark));
	}

	.notif-modal[hidden],
	.notif-backdrop[hidden] {
		display: none;
	}

	.notif-modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.85rem 1rem;
		border-bottom: 2px solid rgb(var(--gray-light));
		background: var(--rafDarkBlue);
		color: #fff;
		flex-shrink: 0;
	}

	.notif-modal-title {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.notif-modal-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin: 0;
		padding: 0.2rem;
		border: none;
		border-radius: 4px;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.notif-modal-close:focus-visible {
		outline: 3px solid var(--rafRed);
		outline-offset: 2px;
	}

	.notif-modal-body {
		overflow-y: auto;
		padding: 0.75rem 1rem 1.25rem;
		flex: 1;
	}

	.notif-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.notif-empty {
		margin: 0;
		font-size: 0.88rem;
		color: rgb(var(--gray));
		font-style: italic;
	}

	@media (max-width: 780px) {
		.notif-modal {
			left: 0;
			width: 100%;
			border-radius: 0;
		}
	}
</style>

<script>
	import { buildModalNotificationHtml } from '../lib/notificationHtml';
	import {
		fetchNotifications,
		filterInWindow,
		pruneDismissals,
	} from '../lib/notifications';

	const panel = document.querySelector<HTMLElement>('[data-notif-panel]');
	if (!panel) throw new Error('Missing notification panel');

	const buildId = panel.dataset.buildId ?? '';
	const bell = panel.querySelector<HTMLButtonElement>('.notif-bell')!;
	const backdrop = panel.querySelector<HTMLElement>('[data-notif-backdrop]')!;
	const modal = panel.querySelector<HTMLElement>('#notif-modal')!;
	const closeBtn = panel.querySelector<HTMLButtonElement>('.notif-modal-close')!;
	const list = panel.querySelector<HTMLElement>('[data-notif-list]')!;
	const empty = panel.querySelector<HTMLElement>('[data-notif-empty]')!;

	let isOpen = false;

	function setOpen(open: boolean) {
		isOpen = open;
		bell.setAttribute('aria-expanded', open ? 'true' : 'false');
		modal.hidden = !open;
		backdrop.hidden = !open;
		backdrop.setAttribute('aria-hidden', open ? 'false' : 'true');
		document.body.style.overflow = open ? 'hidden' : '';
		if (open) {
			void refresh();
			closeBtn.focus();
		}
	}

	async function refresh() {
		const all = await fetchNotifications(buildId);
		const activeIds = new Set(all.map((n) => n.id));
		pruneDismissals(activeIds);

		const inWindow = filterInWindow(all);

		list.innerHTML = inWindow.map(buildModalNotificationHtml).join('');
		empty.hidden = inWindow.length > 0;
		list.hidden = inWindow.length === 0;
	}

	bell.addEventListener('click', () => setOpen(!isOpen));
	closeBtn.addEventListener('click', () => setOpen(false));
	backdrop.addEventListener('click', () => setOpen(false));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen) {
			setOpen(false);
			bell.focus();
		}
	});

	window.addEventListener('notifications:changed', () => {
		void refresh();
	});

	void refresh();
</script>
