---

import { getImage } from 'astro:assets';

import { getEntry } from 'astro:content';

import { resolveCmsImage } from '../utils/cmsImages';



const carouselEntry = await getEntry('landingCarousel', 'items');

const rawSlides = carouselEntry?.data.items ?? [];



const slideEntries = rawSlides.flatMap((slide) => {

	const image = resolveCmsImage(slide.image);

	if (!image) return [];

	return [{ ...slide, image }];

});



const tallestSlide = slideEntries.reduce(

	(best, slide) => {

		const ratio = slide.image.height / slide.image.width;

		return ratio > best.ratio

			? { ratio, width: slide.image.width, height: slide.image.height }

			: best;

	},

	{ ratio: 0, width: 4, height: 3 },

);

const carouselWidths = [480, 768, 1024, 1440];

function carouselSizes(width: number, height: number) {
	// object-fit: contain. Phones are width-constrained; wider screens are limited by carousel height.
	const aspect = (width / height).toFixed(3);
	return `(max-width: 768px) 100vw, min(100vw, calc((75vh - 4.5rem) * ${aspect}))`;
}

const slides = await Promise.all(
	slideEntries.map(async (slide, index) => {
		const sizes = carouselSizes(slide.image.width, slide.image.height);
		const eager = index === 0;
		const optimized = await getImage({
			src: slide.image,
			width: 1024,
			widths: carouselWidths,
			sizes,
			priority: eager,
		});
		const shared = {
			alt: slide.caption ?? '',
			width: optimized.attributes.width,
			height: optimized.attributes.height,
			sizes,
		};
		return {
			...slide,
			img: eager
				? {
						...shared,
						src: optimized.src,
						srcset: optimized.srcSet.attribute,
						loading: 'eager' as const,
						fetchpriority: 'high' as const,
						decoding: 'sync' as const,
					}
				: {
						...shared,
						'data-src': optimized.src,
						'data-srcset': optimized.srcSet.attribute,
						decoding: 'async' as const,
					},
		};
	}),
);

---



<div data-cms-root="landingCarousel">
{slides.length > 0 && (

	<section

		class="carousel"

		style={`--carousel-reserve-w: ${tallestSlide.width}; --carousel-reserve-h: ${tallestSlide.height}`}

		aria-label="Squadron photo carousel"

		aria-roledescription="carousel"

	>

		<div class="carousel-track" role="list">

			{slides.map((slide, i) => (

				<div

					class:list={['carousel-item', { active: i === 0 }]}

					role="listitem"

					aria-roledescription="slide"

					aria-label={`Slide ${i + 1} of ${slides.length}`}

					aria-hidden={i !== 0 ? 'true' : undefined}

				>

					{slide.link ? (

						<a href={slide.link} tabindex={i !== 0 ? -1 : 0} aria-label={slide.caption ?? `Carousel slide ${i + 1}`}>

							<img class="carousel-img" {...slide.img} />

						</a>

					) : (

						<img class="carousel-img" {...slide.img} />

					)}

					{slide.caption && (

						<div class="carousel-caption" aria-hidden="true">

							{slide.caption}

						</div>

					)}

				</div>

			))}

		</div>



		{slides.length > 1 && (

			<>

				<button class="carousel-btn carousel-btn--prev" aria-label="Previous slide" type="button">

					<span class="material-icons" aria-hidden="true">chevron_left</span>

				</button>

				<button class="carousel-btn carousel-btn--next" aria-label="Next slide" type="button">

					<span class="material-icons" aria-hidden="true">chevron_right</span>

				</button>



				<div class="carousel-dots" role="tablist" aria-label="Carousel slides">

					{slides.map((_, i) => (

						<button

							class:list={['carousel-dot', { active: i === 0 }]}

							role="tab"

							aria-selected={i === 0 ? 'true' : 'false'}

							aria-label={`Go to slide ${i + 1}`}

							data-index={i}

							type="button"

						/>

					))}

				</div>



				<div class="carousel-pause-wrapper">

					<button class="carousel-pause" aria-label="Pause carousel" type="button" aria-pressed="false">

						<span class="material-icons" aria-hidden="true">pause</span>

					</button>

				</div>

			</>

		)}

	</section>

)}
</div>

<template data-cms-template="landingCarousel">
	<section
		class="carousel"
		style="--carousel-reserve-w: 4; --carousel-reserve-h: 3"
		aria-label="Squadron photo carousel"
		aria-roledescription="carousel"
	>
		<div class="carousel-track" role="list" data-cms-carousel-track></div>
		<button class="carousel-btn carousel-btn--prev" aria-label="Previous slide" type="button" data-cms-if-multiple>
			<span class="material-icons" aria-hidden="true">chevron_left</span>
		</button>
		<button class="carousel-btn carousel-btn--next" aria-label="Next slide" type="button" data-cms-if-multiple>
			<span class="material-icons" aria-hidden="true">chevron_right</span>
		</button>
		<div class="carousel-dots" role="tablist" aria-label="Carousel slides" data-cms-if-multiple data-cms-carousel-dots></div>
		<div class="carousel-pause-wrapper" data-cms-if-multiple>
			<button class="carousel-pause" aria-label="Pause carousel" type="button" aria-pressed="false">
				<span class="material-icons" aria-hidden="true">pause</span>
			</button>
		</div>
	</section>
</template>
<template data-cms-template="landingCarousel-slide">
	<div class="carousel-item" role="listitem" aria-roledescription="slide">
		<a>
			<img class="carousel-img" alt="" />
		</a>
		<div class="carousel-caption" aria-hidden="true"></div>
	</div>
</template>
<template data-cms-template="landingCarousel-dot">
	<button class="carousel-dot" role="tab" type="button"></button>
</template>

<style>

	.carousel {
		position: relative;
		width: 100%;
		height: calc(75vh - var(--header-height, var(--header-offset)));
		max-height: 80vh;
		min-height: 220px;
		overflow: hidden;

		--d:5000px;
		--angle:135deg;
		--w:100%;

	}

	.carousel::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;

		background: repeating-linear-gradient(var(--angle), var(--color-raf-navy), var(--color-raf-red), var(--color-raf-navy) var(--d));
		background-size: calc(var(--d)/sin(var(--angle))) 100%;
		animation: carousel-bg-shift 20s linear infinite reverse;
	}

	@keyframes carousel-bg-shift {
		0% {
			background-position: calc(var(--d)/sin(var(--angle))) 0;
		}
	}



	.carousel-track {

		position: relative;

		width: 100%;

		height: 100%;

	}



	.carousel-item {

		position: absolute;

		inset: 0;

		opacity: 0;

		transition: opacity 0.7s ease-in-out;

		pointer-events: none;

	}



	.carousel-item.active {

		opacity: 1;

		pointer-events: auto;

	}



	.carousel-item a {

		display: block;

		width: 100%;

		height: 100%;

	}



	.carousel-img {

		width: 100%;

		height: 100%;

		object-fit: contain;

		border-radius: 0;

	}



	.carousel-caption {

		position: absolute;

		bottom: 0;

		left: 0;

		right: 0;

		padding: 1.5rem 1.25rem 3.5rem;

		background: var(--gradient-scrim);

		color: var(--color-white);

		font-size: clamp(0.9rem, 2vw, 1.15rem);

		font-weight: var(--font-weight-semibold);

		text-shadow: var(--shadow-text-sm);

	}



	/* Prev / Next buttons */

	.carousel-btn {

		position: absolute;

		top: 50%;

		transform: translateY(-50%);

		z-index: 10;

		background: var(--color-navy-70);

		color: var(--color-white);

		border: 2px solid var(--color-white-30);

		border-radius: 50%;

		width: 2.75rem;

		height: 2.75rem;

		display: flex;

		align-items: center;

		justify-content: center;

		cursor: pointer;

		transition: background 0.2s ease;

		padding: 0;

	}



	.carousel-btn:hover,

	.carousel-btn:focus-visible {

		background: var(--color-raf-red);

		border-color: var(--color-raf-red);

	}



	.carousel-btn--prev { left: 0.75rem; }

	.carousel-btn--next { right: 0.75rem; }



	.carousel-btn .material-icons {

		font-size: 1.5rem;

		line-height: 1;

	}



	/* Dot indicators */

	.carousel-dots {

		position: absolute;

		bottom: 0.75rem;

		left: 50%;

		transform: translateX(-50%);

		z-index: 10;

		display: flex;

		gap: 0.4rem;

		padding: 0.25rem 0.5rem;

	}



	.carousel-dot {

		width: 0.6rem;

		height: 0.6rem;

		border-radius: 50%;

		background: var(--color-white-50);

		border: none;

		cursor: pointer;

		padding: 0;

		transition: background 0.2s ease, transform 0.2s ease;

	}



	.carousel-dot.active,

	.carousel-dot[aria-selected="true"] {

		background: var(--color-white);

		transform: scale(1.3);

	}



	.carousel-dot:focus-visible {

		outline: var(--focus-ring);

		outline-offset: var(--focus-offset);

	}



	/* Pause button */

	.carousel-pause-wrapper {

		position: absolute;

		bottom: 0.5rem;

		right: 0.75rem;

		z-index: 10;

	}



	.carousel-pause {

		background: var(--color-black-40);

		color: var(--color-white);

		border: none;

		border-radius: var(--radius-sm);

		padding: 0.2rem 0.4rem;

		cursor: pointer;

		display: flex;

		align-items: center;

	}



	.carousel-pause .material-icons {

		font-size: 1rem;

		line-height: 1;

	}



	.carousel-pause:focus-visible {

		outline: var(--focus-ring);

		outline-offset: var(--focus-offset-tight);

	}



	@media (max-width: 768px) {

		.carousel {

			height: auto;

			aspect-ratio: var(--carousel-reserve-w) / var(--carousel-reserve-h);

			max-height: none;

			min-height: 0;

			background: transparent;

		}



		.carousel-track {

			height: 100%;

		}



		.carousel-item,

		.carousel-item.active {

			position: absolute;

			inset: 0;

			width: 100%;

			height: 100%;

		}



		.carousel-item a {

			height: 100%;

		}



		.carousel-img {

			width: 100%;

			height: 100%;

			display: block;

			object-fit: contain;

			object-position: center;

		}



		.carousel-btn {

			width: 2.25rem;

			height: 2.25rem;

		}

	}

</style>


<script>
	import { initLandingCarousel } from '../lib/landingCarousel';

	const carouselEl = document.querySelector<HTMLElement>('.carousel');
	if (carouselEl) initLandingCarousel(carouselEl);
</script>
