---

import { getImage } from 'astro:assets';

import { getEntry } from 'astro:content';

import { resolveCmsImage } from '../utils/cmsImages';



const carouselEntry = await getEntry('landingCarousel', 'items');

const rawSlides = carouselEntry?.data.items ?? [];



const slideEntries = rawSlides.flatMap((slide) => {

	const image = resolveCmsImage(slide.image);

	if (!image) return [];

	return [{ ...slide, image }];

});



const tallestSlide = slideEntries.reduce(

	(best, slide) => {

		const ratio = slide.image.height / slide.image.width;

		return ratio > best.ratio

			? { ratio, width: slide.image.width, height: slide.image.height }

			: best;

	},

	{ ratio: 0, width: 4, height: 3 },

);

const carouselWidths = [480, 768, 1024, 1440];

function carouselSizes(width: number, height: number) {
	// object-fit: contain. Phones are width-constrained; wider screens are limited by carousel height.
	const aspect = (width / height).toFixed(3);
	return `(max-width: 768px) 100vw, min(100vw, calc((75vh - 4.5rem) * ${aspect}))`;
}

const slides = await Promise.all(
	slideEntries.map(async (slide, index) => {
		const sizes = carouselSizes(slide.image.width, slide.image.height);
		const eager = index === 0;
		const optimized = await getImage({
			src: slide.image,
			width: 1024,
			widths: carouselWidths,
			sizes,
			priority: eager,
		});
		const shared = {
			alt: slide.caption ?? '',
			width: optimized.attributes.width,
			height: optimized.attributes.height,
			sizes,
		};
		return {
			...slide,
			img: eager
				? {
						...shared,
						src: optimized.src,
						srcset: optimized.srcSet.attribute,
						loading: 'eager' as const,
						fetchpriority: 'high' as const,
						decoding: 'sync' as const,
					}
				: {
						...shared,
						'data-src': optimized.src,
						'data-srcset': optimized.srcSet.attribute,
						decoding: 'async' as const,
					},
		};
	}),
);

---



{slides.length > 0 && (

	<section

		class="carousel"

		style={`--carousel-reserve-w: ${tallestSlide.width}; --carousel-reserve-h: ${tallestSlide.height}`}

		aria-label="Squadron photo carousel"

		aria-roledescription="carousel"

	>

		<div class="carousel-track" role="list">

			{slides.map((slide, i) => (

				<div

					class:list={['carousel-item', { active: i === 0 }]}

					role="listitem"

					aria-roledescription="slide"

					aria-label={`Slide ${i + 1} of ${slides.length}`}

					aria-hidden={i !== 0 ? 'true' : undefined}

				>

					{slide.link ? (

						<a href={slide.link} tabindex={i !== 0 ? -1 : 0} aria-label={slide.caption ?? `Carousel slide ${i + 1}`}>

							<img class="carousel-img" {...slide.img} />

						</a>

					) : (

						<img class="carousel-img" {...slide.img} />

					)}

					{slide.caption && (

						<div class="carousel-caption" aria-hidden="true">

							{slide.caption}

						</div>

					)}

				</div>

			))}

		</div>



		{slides.length > 1 && (

			<>

				<button class="carousel-btn carousel-btn--prev" aria-label="Previous slide" type="button">

					<span class="material-icons" aria-hidden="true">chevron_left</span>

				</button>

				<button class="carousel-btn carousel-btn--next" aria-label="Next slide" type="button">

					<span class="material-icons" aria-hidden="true">chevron_right</span>

				</button>



				<div class="carousel-dots" role="tablist" aria-label="Carousel slides">

					{slides.map((_, i) => (

						<button

							class:list={['carousel-dot', { active: i === 0 }]}

							role="tab"

							aria-selected={i === 0 ? 'true' : 'false'}

							aria-label={`Go to slide ${i + 1}`}

							data-index={i}

							type="button"

						/>

					))}

				</div>



				<div class="carousel-pause-wrapper">

					<button class="carousel-pause" aria-label="Pause carousel" type="button" aria-pressed="false">

						<span class="material-icons" aria-hidden="true">pause</span>

					</button>

				</div>

			</>

		)}

	</section>

)}



<style>

	.carousel {
		position: relative;
		width: 100%;
		height: calc(75vh - var(--header-height, var(--header-offset)));
		max-height: 80vh;
		min-height: 220px;
		overflow: hidden;

		--d:5000px;
		--angle:135deg;
		--w:100%;

	}

	.carousel::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;

		background: repeating-linear-gradient(var(--angle), var(--color-raf-navy), var(--color-raf-red), var(--color-raf-navy) var(--d));
		background-size: calc(var(--d)/sin(var(--angle))) 100%;
		animation: carousel-bg-shift 20s linear infinite reverse;
	}

	@keyframes carousel-bg-shift {
		0% {
			background-position: calc(var(--d)/sin(var(--angle))) 0;
		}
	}



	.carousel-track {

		position: relative;

		width: 100%;

		height: 100%;

	}



	.carousel-item {

		position: absolute;

		inset: 0;

		opacity: 0;

		transition: opacity 0.7s ease-in-out;

		pointer-events: none;

	}



	.carousel-item.active {

		opacity: 1;

		pointer-events: auto;

	}



	.carousel-item a {

		display: block;

		width: 100%;

		height: 100%;

	}



	.carousel-img {

		width: 100%;

		height: 100%;

		object-fit: contain;

		border-radius: 0;

	}



	.carousel-caption {

		position: absolute;

		bottom: 0;

		left: 0;

		right: 0;

		padding: 1.5rem 1.25rem 3.5rem;

		background: var(--gradient-scrim);

		color: var(--color-white);

		font-size: clamp(0.9rem, 2vw, 1.15rem);

		font-weight: var(--font-weight-semibold);

		text-shadow: var(--shadow-text-sm);

	}



	/* Prev / Next buttons */

	.carousel-btn {

		position: absolute;

		top: 50%;

		transform: translateY(-50%);

		z-index: 10;

		background: var(--color-navy-70);

		color: var(--color-white);

		border: 2px solid var(--color-white-30);

		border-radius: 50%;

		width: 2.75rem;

		height: 2.75rem;

		display: flex;

		align-items: center;

		justify-content: center;

		cursor: pointer;

		transition: background 0.2s ease;

		padding: 0;

	}



	.carousel-btn:hover,

	.carousel-btn:focus-visible {

		background: var(--color-raf-red);

		border-color: var(--color-raf-red);

	}



	.carousel-btn--prev { left: 0.75rem; }

	.carousel-btn--next { right: 0.75rem; }



	.carousel-btn .material-icons {

		font-size: 1.5rem;

		line-height: 1;

	}



	/* Dot indicators */

	.carousel-dots {

		position: absolute;

		bottom: 0.75rem;

		left: 50%;

		transform: translateX(-50%);

		z-index: 10;

		display: flex;

		gap: 0.4rem;

		padding: 0.25rem 0.5rem;

	}



	.carousel-dot {

		width: 0.6rem;

		height: 0.6rem;

		border-radius: 50%;

		background: var(--color-white-50);

		border: none;

		cursor: pointer;

		padding: 0;

		transition: background 0.2s ease, transform 0.2s ease;

	}



	.carousel-dot.active,

	.carousel-dot[aria-selected="true"] {

		background: var(--color-white);

		transform: scale(1.3);

	}



	.carousel-dot:focus-visible {

		outline: var(--focus-ring);

		outline-offset: var(--focus-offset);

	}



	/* Pause button */

	.carousel-pause-wrapper {

		position: absolute;

		bottom: 0.5rem;

		right: 0.75rem;

		z-index: 10;

	}



	.carousel-pause {

		background: var(--color-black-40);

		color: var(--color-white);

		border: none;

		border-radius: var(--radius-sm);

		padding: 0.2rem 0.4rem;

		cursor: pointer;

		display: flex;

		align-items: center;

	}



	.carousel-pause .material-icons {

		font-size: 1rem;

		line-height: 1;

	}



	.carousel-pause:focus-visible {

		outline: var(--focus-ring);

		outline-offset: var(--focus-offset-tight);

	}



	@media (max-width: 768px) {

		.carousel {

			height: auto;

			aspect-ratio: var(--carousel-reserve-w) / var(--carousel-reserve-h);

			max-height: none;

			min-height: 0;

			background: transparent;

		}



		.carousel-track {

			height: 100%;

		}



		.carousel-item,

		.carousel-item.active {

			position: absolute;

			inset: 0;

			width: 100%;

			height: 100%;

		}



		.carousel-item a {

			height: 100%;

		}



		.carousel-img {

			width: 100%;

			height: 100%;

			display: block;

			object-fit: contain;

			object-position: center;

		}



		.carousel-btn {

			width: 2.25rem;

			height: 2.25rem;

		}

	}

</style>


<script>

	const carouselEl = document.querySelector<HTMLElement>('.carousel');

	if (carouselEl) {

	const carousel = carouselEl;

	function loadDeferredSlides() {
		carousel.querySelectorAll<HTMLImageElement>('img.carousel-img[data-src]').forEach((img) => {
			if (img.dataset.srcset) img.srcset = img.dataset.srcset;
			if (img.dataset.src) img.src = img.dataset.src;
			img.removeAttribute('data-src');
			img.removeAttribute('data-srcset');
		});
	}

	const scheduleDeferredSlides = () => {
		const run = () => loadDeferredSlides();
		const later = () => window.requestIdleCallback(run, { timeout: 2000 });
		if (document.readyState === 'complete') later();
		else window.addEventListener('load', later, { once: true });
	};
	scheduleDeferredSlides();

	const items = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-item'));

	const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot'));

	const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn--prev');

	const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn--next');

	const pauseBtn = carousel.querySelector<HTMLButtonElement>('.carousel-pause');

	const pauseIcon = pauseBtn?.querySelector<HTMLElement>('.material-icons');



	if (items.length <= 1) {

		// Single slide – nothing to do

	} else {

		let current = 0;

		let intervalId: ReturnType<typeof setInterval> | null = null;

		let userPaused = false;

		let inViewport = true;

		const INTERVAL_MS = 4000;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;



		function goTo(index: number) {

			loadDeferredSlides();

			items[current].classList.remove('active');

			items[current].setAttribute('aria-hidden', 'true');

			dots[current]?.classList.remove('active');

			dots[current]?.setAttribute('aria-selected', 'false');



			current = (index + items.length) % items.length;



			items[current].classList.add('active');

			items[current].removeAttribute('aria-hidden');

			dots[current]?.classList.add('active');

			dots[current]?.setAttribute('aria-selected', 'true');

		}



		function clearAuto() {

			if (intervalId) {

				clearInterval(intervalId);

				intervalId = null;

			}

		}



		function updatePauseButton(paused: boolean) {

			if (!pauseBtn) return;

			pauseBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');

			if (pauseIcon) pauseIcon.textContent = paused ? 'play_arrow' : 'pause';

			pauseBtn.setAttribute('aria-label', paused ? 'Play carousel' : 'Pause carousel');

		}



		function startAuto() {

			if (reduceMotion || userPaused || !inViewport) return;

			clearAuto();

			intervalId = setInterval(() => goTo(current + 1), INTERVAL_MS);

			updatePauseButton(false);

		}



		function stopAuto() {

			userPaused = true;

			clearAuto();

			updatePauseButton(true);

		}



		prevBtn?.addEventListener('click', () => { stopAuto(); goTo(current - 1); });

		nextBtn?.addEventListener('click', () => { stopAuto(); goTo(current + 1); });



		dots.forEach((dot, i) => {

			dot.addEventListener('click', () => { stopAuto(); goTo(i); });

		});



		pauseBtn?.addEventListener('click', () => {

			if (userPaused) {

				userPaused = false;

				startAuto();

			} else {

				stopAuto();

			}

		});



		// Keyboard navigation

		carousel.addEventListener('keydown', (e: KeyboardEvent) => {

			if (e.key === 'ArrowLeft') { stopAuto(); goTo(current - 1); }

			if (e.key === 'ArrowRight') { stopAuto(); goTo(current + 1); }

		});



		// Pause on hover/focus

		carousel.addEventListener('mouseenter', clearAuto);

		carousel.addEventListener('focusin', clearAuto);

		carousel.addEventListener('mouseleave', startAuto);

		carousel.addEventListener('focusout', (e: FocusEvent) => {

			if (!carousel.contains(e.relatedTarget as Node)) startAuto();

		});



		function isPrimaryView(entry: IntersectionObserverEntry) {

			const rootHeight = entry.rootBounds?.height ?? window.innerHeight;

			const visibleHeight = entry.intersectionRect.height;

			const targetHeight = entry.boundingClientRect.height;

			const mostlyOnScreen = targetHeight > 0 && visibleHeight / targetHeight >= 0.6;

			const dominatesViewport = rootHeight > 0 && visibleHeight / rootHeight >= 0.4;

			return entry.isIntersecting && (mostlyOnScreen || dominatesViewport);

		}



		const viewportObserver = new IntersectionObserver(

			(entries) => {

				const entry = entries[0];

				inViewport = entry ? isPrimaryView(entry) : false;

				if (inViewport) {

					startAuto();

				} else {

					clearAuto();

				}

			},

			{ threshold: [0, 0.25, 0.5, 0.75, 1] },

		);

		viewportObserver.observe(carousel);



		if (!reduceMotion) startAuto();

	}

	}

</script>


