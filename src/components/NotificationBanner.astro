---
interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const buildId = import.meta.env.PUBLIC_BUILD_ID ?? '';
---

<div
	class:list={['notification-strip', { 'notification-strip--overlay': overlay }]}
	hidden
	aria-live="polite"
	aria-label="Site notifications"
	role="region"
	data-notification-banner
	data-build-id={buildId}
>
	<div class="notification-list"></div>
</div>

<style>
	.notification-strip {
		width: 100%;
		background: linear-gradient(180deg, #f4f7fb 0%, #fff 100%);
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.notification-strip[hidden] {
		display: none;
	}

	.notification-strip--overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 15;
		background: transparent;
		border-bottom: none;
		pointer-events: none;
	}

	.notification-strip--overlay .notification-list {
		pointer-events: auto;
	}

	.notification-list {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.85rem 1.25rem 1rem;
	}

	@media (max-width: 600px) {
		.notification-list {
			padding: 0.75rem 1rem 0.85rem;
			gap: 0.5rem;
		}
	}
</style>

<script>
	import { buildBannerNotificationHtml } from '../lib/notificationHtml';
	import {
		dismiss,
		fetchNotifications,
		filterVisible,
		pruneDismissals,
	} from '../lib/notifications';

	const strip = document.querySelector<HTMLElement>('[data-notification-banner]');
	const list = strip?.querySelector<HTMLElement>('.notification-list');

	if (strip && list) {
		const buildId = strip.dataset.buildId ?? '';

		list.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-dismiss-id]');
			if (!btn) return;
			const id = btn.dataset.dismissId;
			if (!id) return;
			dismiss(id);
			window.dispatchEvent(new CustomEvent('notifications:changed'));
		});

		async function renderBanner() {
			const all = await fetchNotifications(buildId);
			const activeIds = new Set(all.map((n) => n.id));
			pruneDismissals(activeIds);

			const visible = filterVisible(all);
			list!.innerHTML = visible.map(buildBannerNotificationHtml).join('');
			strip!.hidden = visible.length === 0;
		}

		renderBanner();
		window.addEventListener('notifications:changed', () => renderBanner());
	}
</script>
