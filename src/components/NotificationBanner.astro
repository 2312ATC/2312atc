---
import { getCollection } from 'astro:content';

const allNotifications = await getCollection('notifications');
const active = allNotifications
	.filter((n) => n.data.active)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

{active.length > 0 && (
	<div
		class="notification-list"
		aria-live="polite"
		aria-label="Site notifications"
		role="region"
	>
		{active.map((n) => (
			<div
				class:list={['notification', `notification--${n.data.type}`]}
				role="alert"
				aria-atomic="true"
				data-notif-id={n.id}
			>
				<span class="notification-icon material-icons" aria-hidden="true">
					{n.data.type === 'alert' ? 'error' : n.data.type === 'warning' ? 'warning' : 'info'}
				</span>
				<div class="notification-content">
					<strong class="notification-title">{n.data.title}</strong>
					<span class="notification-message">{n.data.message}</span>
				</div>
				<button
					class="notification-dismiss"
					aria-label={`Dismiss notification: ${n.data.title}`}
					type="button"
					data-dismiss-id={n.id}
				>
					<span class="material-icons" aria-hidden="true">close</span>
				</button>
			</div>
		))}
	</div>
)}

<style>
	.notification-list {
		width: 100%;
	}

	.notification {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		border-left: 5px solid;
		margin-bottom: 2px;
		font-size: 0.95rem;
		line-height: 1.4;
		position: relative;
	}

	.notification--info {
		background: #eff6ff;
		border-color: #3b82f6;
		color: #1e3a5f;
	}
	.notification--warning {
		background: #fffbeb;
		border-color: #f59e0b;
		color: #78350f;
	}
	.notification--alert {
		background: #fef2f2;
		border-color: var(--rafRed);
		color: #7f1d1d;
	}

	.notification-icon {
		font-size: 1.3rem;
		flex-shrink: 0;
		margin-top: 1px;
	}

	.notification--info .notification-icon    { color: #2563eb; }
	.notification--warning .notification-icon { color: #d97706; }
	.notification--alert .notification-icon   { color: var(--rafRed); }

	.notification-content {
		flex: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.75rem;
		align-items: baseline;
	}

	.notification-title {
		font-weight: 700;
	}

	.notification-message {
		font-weight: 400;
	}

	.notification-dismiss {
		background: none;
		border: none;
		cursor: pointer;
		color: inherit;
		opacity: 0.6;
		padding: 0.1rem;
		display: flex;
		align-items: center;
		flex-shrink: 0;
		border-radius: 4px;
		transition: opacity 0.15s;
	}

	.notification-dismiss:hover,
	.notification-dismiss:focus-visible {
		opacity: 1;
	}

	.notification-dismiss .material-icons {
		font-size: 1.1rem;
	}

	.notification[hidden] {
		display: none;
	}
</style>

<script>
	const STORAGE_KEY = 'dismissed-notifications';

	function getDismissed(): string[] {
		try {
			return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]');
		} catch {
			return [];
		}
	}

	function dismiss(id: string) {
		const dismissed = getDismissed();
		if (!dismissed.includes(id)) dismissed.push(id);
		localStorage.setItem(STORAGE_KEY, JSON.stringify(dismissed));
	}

	// Hide already-dismissed notifications immediately
	const dismissed = getDismissed();
	document.querySelectorAll<HTMLElement>('[data-notif-id]').forEach((el) => {
		const id = el.dataset.notifId ?? '';
		if (dismissed.includes(id)) el.hidden = true;
	});

	// Wire up dismiss buttons
	document.querySelectorAll<HTMLButtonElement>('[data-dismiss-id]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.dataset.dismissId ?? '';
			dismiss(id);
			const notification = btn.closest<HTMLElement>('[data-notif-id]');
			if (notification) {
				notification.hidden = true;
			}
		});
	});
</script>
