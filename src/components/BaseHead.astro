---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/images/20260116_194339815_iOS.jpg';
import orgLogo from '../assets/images/logo.jpg';
import { SITE_TITLE } from '../consts';
import { gitDatesForPathname } from '../lib/gitHistory';
import {
	breadcrumbJsonLd,
	buildJsonLdGraph,
	canonicalUrlFromPath,
	type JsonLdNode,
	type WebPageType,
} from '../lib/jsonLd';

// Omitted from the build unless PUBLIC_PREVIEW_GATE=true. The dynamic import
// sits in that branch so Vite can drop the component when the flag is off.
let PreviewPasswordGate: (typeof import('./PreviewPasswordGate.astro'))['default'] | undefined;
if (import.meta.env.PUBLIC_PREVIEW_GATE === 'true') {
	PreviewPasswordGate = (await import('./PreviewPasswordGate.astro')).default;
}

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	pageType?: WebPageType;
	ogType?: 'website' | 'article';
	breadcrumbs?: { name: string; path: string }[];
	jsonLd?: JsonLdNode[];
}

const siteURL = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = canonicalUrlFromPath(Astro.url.pathname, siteURL);
const siteOrigin = siteURL.origin.replace(/\/$/, '');

const {
	title,
	description,
	image = FallbackImage,
	pageType = 'WebPage',
	ogType = 'website',
	breadcrumbs,
	jsonLd,
} = Astro.props;
const ogImageURL = new URL(image.src, siteURL);
const logoURL = new URL(orgLogo.src, siteURL);
const isHome = canonicalURL.pathname === '/';

const breadcrumbItems = breadcrumbs?.map((crumb) => ({
	name: crumb.name,
	url: new URL(crumb.path, siteURL).href,
}));
const pageDates = gitDatesForPathname(canonicalURL.pathname);
const jsonLdGraph = buildJsonLdGraph({
	siteOrigin,
	canonicalUrl: canonicalURL.href,
	title,
	description,
	logoUrl: logoURL.href,
	pageType,
	extra: jsonLd,
	isHome,
	datePublished: pageDates?.created,
	dateModified: pageDates?.updated,
});
const breadcrumbGraph =
	breadcrumbItems && breadcrumbItems.length > 0
		? breadcrumbJsonLd(breadcrumbItems, canonicalURL.href)
		: undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#002e60">
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />
<meta name="google-site-verification" content="CkGNTghKEK0NnTVIiqbcJU-BycxpbJAq2JInQ3hD2xk" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
{breadcrumbGraph && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbGraph)} />
)}

{PreviewPasswordGate && <PreviewPasswordGate />}
