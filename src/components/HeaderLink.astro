---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

function stripBase(pathname: string) {
	const base = import.meta.env.BASE_URL || '/';
	if (base !== '/' && pathname.startsWith(base)) {
		const rest = pathname.slice(base.length);
		return rest.startsWith('/') ? rest : `/${rest}`;
	}
	return pathname || '/';
}

function normalize(path: string) {
	if (!path.startsWith('/') || path.startsWith('//')) return path;
	let value = path.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
	if (value.length > 1 && value.endsWith('/')) value = value.slice(0, -1);
	return value || '/';
}

const pathname = normalize(stripBase(Astro.url.pathname));
const link = typeof href === 'string' ? normalize(href) : '';
const subpath = pathname.match(/[^/]+/g);
const isActive = link === pathname || link === '/' + (subpath?.[0] || '');
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>

<style>
	a {
		color: var(--color-white-90);
		font-weight: var(--font-weight-semibold);
		font-size: 0.95rem;
		display: inline-block;
		text-decoration: none;
		padding: 0.5rem 0.6rem;
		border-radius: var(--radius-sm);
		transition: color var(--duration-fast), background var(--duration-fast);
		white-space: nowrap;
	}

	a:hover {
		color: var(--color-white);
		background: var(--color-white-10);
	}

	a.active,
	a[aria-current="page"] {
		color: var(--color-white);
		font-weight: var(--font-weight-bold);
		background: var(--color-white-12);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	a:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-offset-tight);
	}
</style>
