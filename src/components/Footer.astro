---
import { SITE_TITLE, SQUADRON_EMAIL, PARADE_NIGHTS, SQUADRON_ADDRESS } from '../consts';
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-col footer-brand">
			<p class="footer-title">{SITE_TITLE}</p>
			<p class="footer-tagline">Part of the Royal Air Force Air Cadets.<br />South West Wing.</p>
			<p class="footer-address">
				<span class="material-icons" aria-hidden="true">location_on</span>
				{SQUADRON_ADDRESS}
			</p>
		</div>

		<nav class="footer-col footer-links" aria-label="Footer navigation">
			<h2 class="footer-col-heading">Quick Links</h2>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/about">About Us</a></li>
				<li><a href="/whatWeDo">What We Do</a></li>
				<li><a href="/events">Events</a></li>
				<li><a href="/blog/page/1">News &amp; Blog</a></li>
				<li><a href="/cadets">For Cadets</a></li>
				<li><a href="/joinUs">Join Us</a></li>
				<li><a href="/contact">Contact</a></li>
			</ul>
		</nav>

		<div class="footer-col footer-contact">
			<h2 class="footer-col-heading">Contact &amp; Parades</h2>
			<ul class="footer-contact-list">
				<li>
					<span class="material-icons" aria-hidden="true">event</span>
					<span><strong>Parade Nights:</strong><br />{PARADE_NIGHTS}</span>
				</li>
				<li>
					<span class="material-icons" aria-hidden="true">email</span>
					<a href={`mailto:${SQUADRON_EMAIL}`}>{SQUADRON_EMAIL}</a>
				</li>
			</ul>
			<div class="footer-external">
				<a
					href="https://www.raf.mod.uk/aircadets/"
					target="_blank"
					rel="noopener noreferrer"
					class="footer-external-link"
				>
					<span class="material-icons" aria-hidden="true">open_in_new</span>
					RAFAC Official Website
				</a>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<p>
			&copy; {new Date().getFullYear()} 2312 (Tavistock) Squadron Air Training Corps.
			<span class="footer-bottom-sep" aria-hidden="true">·</span>
			<a href="/contact">Contact</a>
			<span class="footer-bottom-sep" aria-hidden="true">·</span>
			<a href="https://www.raf.mod.uk/aircadets/" target="_blank" rel="noopener noreferrer">RAFAC</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-raf-navy);
		color: var(--color-white-80);
		border-top: var(--accent-bar) solid var(--color-raf-red);
	}

	.footer-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 1.5rem;
		display: grid;
		grid-template-columns: 2fr 1fr 1.5fr;
		gap: 2.5rem;
	}

	@media (max-width: var(--prose-width)) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 480px) {
		.footer-inner {
			grid-template-columns: 1fr;
		}
	}

	/* Brand column */
	.footer-title {
		font-size: 1.05rem;
		font-weight: var(--font-weight-extrabold);
		color: var(--color-white);
		margin-bottom: 0.4rem;
	}

	.footer-tagline {
		font-size: 0.85rem;
		line-height: var(--leading-copy);
		color: var(--color-white-65);
		margin-bottom: 0.75rem;
	}

	.footer-address {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		color: var(--color-white-65);
		margin: 0;
	}

	.footer-address .material-icons {
		font-size: 1rem;
		color: var(--color-raf-red);
	}

	/* Columns */
	.footer-col-heading {
		font-size: 0.72rem;
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-caps);
		color: var(--color-raf-red);
		margin-bottom: 1rem;
	}

	.footer-links ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.footer-links a {
		color: var(--color-white-75);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color var(--duration-fast);
	}

	.footer-links a:hover {
		color: var(--color-white);
		text-decoration: underline;
	}

	/* Contact column */
	.footer-contact-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-contact-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: 0.88rem;
		color: var(--color-white-80);
	}

	.footer-contact-list .material-icons {
		font-size: 1rem;
		color: var(--color-raf-red);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.footer-contact-list a {
		color: var(--color-white-80);
		text-decoration: none;
	}

	.footer-contact-list a:hover {
		color: var(--color-white);
		text-decoration: underline;
	}

	.footer-external-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.82rem;
		color: var(--color-white-65);
		text-decoration: none;
		border: 1px solid var(--color-white-20);
		border-radius: var(--radius-sm);
		padding: 0.3rem 0.75rem;
		transition: border-color var(--duration-fast), color var(--duration-fast);
	}

	.footer-external-link:hover {
		border-color: var(--color-white-50);
		color: var(--color-white);
	}

	.footer-external-link .material-icons { font-size: 0.9rem; }

	/* Bottom bar */
	.footer-bottom {
		border-top: 1px solid var(--color-white-10);
		padding: 0.85rem 1.25rem;
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.footer-bottom p {
		font-size: 0.8rem;
		color: var(--color-white-45);
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.footer-bottom a {
		color: var(--color-white-55);
		text-decoration: none;
		transition: color var(--duration-fast);
	}

	.footer-bottom a:hover { color: var(--color-white); }

	.footer-bottom-sep { color: var(--color-white-25); }
</style>
