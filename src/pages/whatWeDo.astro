---
import Page from '../layouts/Page.astro';
import { getEntry } from 'astro:content';

const activitiesEntry = await getEntry('activities', 'items');
const activities = activitiesEntry?.data.items ?? [];
const renderedActivities = activities.map((activity, i) => ({
	activity,
	isAlt: i % 2 !== 0,
}));
---

<Page title="What We Do | 2312 Squadron Air Cadets" description="Discover all the activities, training and opportunities available through 2312 Squadron Air Cadets.">
	<div class="hero-banner">
		<h1>What We Do</h1>
		<p>Discover the activities and opportunities that make Air Cadets so special</p>
	</div>

	<div class="page-content">
		<nav aria-label="Breadcrumb" class="breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">What We Do</span>
		</nav>

		<p class="wwd-intro">
			2312 Squadron offers a wide range of activities through the Royal Air Force Air Cadet programme. From aviation to adventure training, from music to marksmanship - there is something for every young person who walks through our door.
		</p>

		<!-- Activity sections (CMS-driven) -->
		<div class="wwd-sections">
			{renderedActivities.map(({ activity, isAlt }, i) => (
				<section
					aria-labelledby={`wwd-${i}`}
					class:list={['wwd-block', { 'wwd-block--alt': isAlt }]}
				>
					<div class="wwd-block-icon">
						<span class="material-icons" aria-hidden="true">{activity.icon}</span>
					</div>
					<div class="wwd-block-content">
						<h2 id={`wwd-${i}`} class="wwd-block-title">{activity.title}</h2>
						<div class="wwd-block-prose" set:html={activity.bodyHtml} />
					</div>
				</section>
			))}
		</div>

		<!-- CTA -->
		<div class="wwd-cta">
			<h2>Want to be part of it?</h2>
			<p>Join 2312 Squadron and start your adventure today.</p>
			<div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;">
				<a href="/join" class="btn btn-primary" style="font-size:1.05rem;padding:0.7rem 2rem;">How to Join</a>
				<a href="/contact" class="btn btn-outline" style="font-size:1.05rem;padding:0.7rem 2rem;color:#fff;border-color:rgba(255,255,255,0.6);">Contact Us</a>
			</div>
		</div>
	</div>
</Page>

<style>
	.wwd-intro {
		font-size: 1.1rem;
		color: rgb(var(--gray-dark));
		line-height: 1.7;
		max-width: 760px;
		margin-bottom: 2.5rem;
	}

	.wwd-sections {
		display: flex;
		flex-direction: column;
		gap: 0;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		margin-bottom: 3rem;
	}

	.wwd-block {
		display: flex;
		gap: 1.5rem;
		padding: 2rem;
		align-items: flex-start;
		background: #fff;
	}

	.wwd-block--alt {
		background: rgba(229,233,240,0.3);
	}

	.wwd-block-icon {
		width: 3.5rem;
		height: 3.5rem;
		background: var(--rafDarkBlue);
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.wwd-block-icon .material-icons {
		color: #fff;
		font-size: 1.6rem;
	}

	.wwd-block-title {
		font-size: 1.2rem;
		color: var(--rafDarkBlue);
		margin-bottom: 0.5rem;
	}

	.wwd-block-content {
		flex: 1;
		min-width: 0;
	}

	.wwd-block-prose :global(p) {
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		line-height: 1.65;
		margin: 0 0 0.5rem;
	}

	.wwd-block-prose :global(strong) {
		color: var(--rafDarkBlue);
	}

	.wwd-block-prose :global(p:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 560px) {
		.wwd-block {
			flex-direction: column;
			gap: 1rem;
			padding: 1.5rem;
		}
		.wwd-block-icon {
			width: 2.75rem;
			height: 2.75rem;
		}
	}

	/* CTA */
	.wwd-cta {
		background: linear-gradient(135deg, var(--rafDarkBlue) 0%, var(--rafLightBlue) 100%);
		border-radius: 12px;
		padding: 2.5rem 2rem;
		text-align: center;
		color: #fff;
	}

	.wwd-cta h2 { color: #fff; font-size: 1.75rem; margin-bottom: 0.5rem; }
	.wwd-cta p { color: rgba(255,255,255,0.85); margin-bottom: 1.5rem; font-size: 1.05rem; }
</style>
