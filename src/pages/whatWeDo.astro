---
import Page from '../layouts/Page.astro';
import { getEntry } from 'astro:content';

const activitiesEntry = await getEntry('activities', 'items');
const activities = activitiesEntry?.data.items ?? [];
const renderedActivities = activities.map((activity, i) => ({
	activity,
	isAlt: i % 2 !== 0,
}));
---

<Page
	title="What We Do | 2312 Squadron Air Cadets"
	description="Discover all the activities, training and opportunities available through 2312 Squadron Air Cadets."
	breadcrumbs={[
		{ name: 'Home', path: '/' },
		{ name: 'What We Do', path: '/whatWeDo' },
	]}
>
	<div class="hero-banner">
		<h1>What We Do</h1>
		<p>Discover the activities and opportunities that make Air Cadets so special</p>
	</div>

	<div class="page-content">
		<nav aria-label="Breadcrumb" class="breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">What We Do</span>
		</nav>

		<p class="wwd-intro">
			2312 Squadron offers a wide range of activities through the Royal Air Force Air Cadet programme. From aviation to adventure training, from music to marksmanship - there is something for every young person who walks through our door.
		</p>

		<!-- Activity sections (CMS-driven) -->
		<div class="wwd-sections">
			{renderedActivities.map(({ activity, isAlt }, i) => (
				<section
					aria-labelledby={`wwd-${i}`}
					class:list={['wwd-block', { 'wwd-block--alt': isAlt }]}
				>
					<div class="wwd-block-icon">
						<span class="material-icons" aria-hidden="true">{activity.icon}</span>
					</div>
					<div class="wwd-block-content">
						<h2 id={`wwd-${i}`} class="wwd-block-title">{activity.title}</h2>
						<div class="wwd-block-prose" set:html={activity.bodyHtml} />
					</div>
				</section>
			))}
		</div>

		<!-- CTA -->
		<div class="band band--inset">
			<h2>Want to be part of it?</h2>
			<p>Join 2312 Squadron and start your adventure today.</p>
			<div class="cta-actions">
				<a href="/join" class="btn btn-primary btn-lg">How to Join</a>
				<a href="/contact" class="btn btn-outline btn-outline--on-dark btn-lg">Contact Us</a>
			</div>
		</div>
	</div>
</Page>

<style>
	.wwd-intro {
		font-size: 1.1rem;
		color: var(--color-body);
		line-height: 1.7;
		max-width: var(--measure-width);
		margin-bottom: 2.5rem;
	}

	.wwd-sections {
		display: flex;
		flex-direction: column;
		gap: 0;
		border-radius: var(--radius-xl);
		overflow: hidden;
		box-shadow: var(--shadow-card);
		margin-bottom: 3rem;
	}

	.wwd-block {
		display: flex;
		gap: 1.5rem;
		padding: 2rem;
		align-items: flex-start;
		background: var(--color-white);
	}

	.wwd-block--alt {
		background: var(--color-line-30);
	}

	.wwd-block-icon {
		width: 3.5rem;
		height: 3.5rem;
		background: var(--color-raf-navy);
		border-radius: var(--radius-lg);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.wwd-block-icon .material-icons {
		color: var(--color-white);
		font-size: 1.6rem;
	}

	.wwd-block-title {
		font-size: 1.2rem;
		color: var(--color-raf-navy);
		margin-bottom: 0.5rem;
	}

	.wwd-block-content {
		flex: 1;
		min-width: 0;
	}

	.wwd-block-prose :global(p) {
		font-size: 0.95rem;
		color: var(--color-body);
		line-height: 1.65;
		margin: 0 0 0.5rem;
	}

	.wwd-block-prose :global(strong) {
		color: var(--color-raf-navy);
	}

	.wwd-block-prose :global(p:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 560px) {
		.wwd-block {
			flex-direction: column;
			gap: 1rem;
			padding: 1.5rem;
		}
		.wwd-block-icon {
			width: 2.75rem;
			height: 2.75rem;
		}
	}
</style>
