---
import Page from '../layouts/Page.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import logo from '../assets/images/logo.jpg';

const staffMembers = (await getCollection('staff'))
	.sort((a, b) => a.data.order - b.data.order);
---

<Page title="About Us | 2312 Squadron Air Cadets" description="Learn about 2312 (Tavistock) Squadron Air Cadets — our history, mission and the team behind the squadron.">
	<div class="hero-banner">
		<h1>About 2312 Squadron</h1>
		<p>Proudly serving Tavistock and the surrounding area since 1944</p>
	</div>

	<div class="page-content">
		<nav aria-label="Breadcrumb" class="breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">About</span>
		</nav>

		<!-- Mission / intro -->
		<section aria-labelledby="about-mission-heading" class="about-section about-intro">
			<div class="about-intro-text">
				<h2 id="about-mission-heading" class="section-heading">Who We Are</h2>
				<p>
					2312 (Tavistock) Squadron is a unit of the <strong>Royal Air Force Air Cadets (RAFAC)</strong> — one of the UK's largest and most respected youth organisations, with over 40,000 cadets nationwide. We are part of South West Wing, Air Cadets.
				</p>
				<p>
					Our squadron provides young people aged 12 to 20 with an outstanding range of activities and opportunities that develop character, leadership and teamwork skills in a fun, safe environment with a strong connection to aviation and the RAF.
				</p>
				<p>
					Whether a cadet is interested in flying, shooting, music, sport, community service, or simply making new friends — there is something for everyone at 2312.
				</p>
			</div>
			<div class="about-intro-logo">
				<Image src={logo} alt="2312 Squadron Royal Air Force Air Cadets badge" width={280} height={280} />
			</div>
		</section>

		<hr class="about-divider" />

		<!-- What we offer -->
		<section aria-labelledby="about-activities-heading" class="about-section">
			<h2 id="about-activities-heading" class="section-heading">What We Offer</h2>
			<div class="activities-grid">
				<div class="activity-card">
					<span class="material-icons activity-icon" aria-hidden="true">flight</span>
					<h3>Flying &amp; Gliding</h3>
					<p>Air experience flights in Grob Tutors and gliding opportunities through the RAFAC Air Experience Flying programme.</p>
				</div>
				<div class="activity-card">
					<span class="material-icons activity-icon" aria-hidden="true">gps_fixed</span>
					<h3>Shooting</h3>
					<p>Smallbore and air rifle shooting, with the opportunity to compete at wing, regional and national level.</p>
				</div>
				<div class="activity-card">
					<span class="material-icons activity-icon" aria-hidden="true">terrain</span>
					<h3>Adventure Training</h3>
					<p>Hiking, climbing, kayaking and more across Dartmoor and beyond — including Duke of Edinburgh Award expeditions.</p>
				</div>
				<div class="activity-card">
					<span class="material-icons activity-icon" aria-hidden="true">military_tech</span>
					<h3>Drill &amp; Discipline</h3>
					<p>Develop self-discipline, teamwork and pride through regular drill practice and ceremonial events.</p>
				</div>
				<div class="activity-card">
					<span class="material-icons activity-icon" aria-hidden="true">school</span>
					<h3>BTEC Qualifications</h3>
					<p>Earn nationally recognised qualifications in Aviation Studies and Public Services through the RAFAC BTEC programme.</p>
				</div>
				<div class="activity-card">
					<span class="material-icons activity-icon" aria-hidden="true">groups</span>
					<h3>Leadership</h3>
					<p>Progress through the cadet ranks and develop real leadership skills that will serve you for life.</p>
				</div>
			</div>
		</section>

		<hr class="about-divider" />

		<!-- History -->
		<section aria-labelledby="about-history-heading" class="about-section">
			<h2 id="about-history-heading" class="section-heading">Our History</h2>
			<div class="prose-content">
				<p>
					2312 Squadron was formed in <strong>1944</strong> during the Second World War as part of the Air Training Corps, which was established to prepare young men and women for service in the RAF and the wider war effort.
				</p>
				<p>
					Over eight decades later, the squadron continues to thrive in Tavistock, serving the young people of the town and the surrounding Devon countryside. The squadron has a proud record of sending cadets on to careers in the RAF and other armed services, as well as aviation, engineering and many other fields.
				</p>
				<p>
					Today we are part of the <strong>Royal Air Force Air Cadets</strong>, which has over 1,000 squadrons across the United Kingdom and is overseen by Air Commodores, with our local unit part of South West Wing.
				</p>
			</div>
		</section>

		<hr class="about-divider" />

		<!-- Staff -->
		<section aria-labelledby="about-staff-heading" class="about-section">
			<h2 id="about-staff-heading" class="section-heading">Our Staff</h2>
			<p style="color:rgb(var(--gray-dark)); margin-bottom:1.5rem;">
				Our squadron is run by a team of dedicated volunteer Civilian Instructors (CIs) and Cadet Force Adult Volunteers (CFAVs), led by our Commanding Officer.
			</p>
			<div class="staff-grid">
				{staffMembers.map((member) => (
					<div class="staff-card">
						<div class="staff-card-rank">{member.data.role}</div>
						<div class="staff-card-name">{member.data.name}</div>
						{member.data.bio && <p class="staff-card-bio">{member.data.bio}</p>}
					</div>
				))}
			</div>
			<p style="margin-top:1.25rem;">
				<a href="/contact" class="btn btn-primary">Get in touch with the squadron</a>
			</p>
		</section>
	</div>
</Page>

<style>
	.about-section {
		margin-bottom: 0.5rem;
	}

	.about-divider {
		border: none;
		border-top: 2px solid rgb(var(--gray-light));
		margin: 2.5rem 0;
	}

	/* Intro with logo */
	.about-intro {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: start;
	}

	.about-intro-logo img {
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		max-width: 220px;
	}

	@media (max-width: 640px) {
		.about-intro {
			grid-template-columns: 1fr;
		}
		.about-intro-logo {
			text-align: center;
		}
	}

	.about-intro-text p {
		color: rgb(var(--gray-dark));
		line-height: 1.75;
		margin-bottom: 1rem;
	}

	/* Activities grid */
	.activities-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.25rem;
		margin-top: 1.5rem;
	}

	.activity-card {
		background: #fff;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		padding: 1.25rem;
		text-align: center;
		border-top: 3px solid var(--rafRed);
	}

	.activity-icon {
		font-size: 2rem;
		color: var(--rafDarkBlue);
		margin-bottom: 0.5rem;
		display: block;
	}

	.activity-card h3 {
		font-size: 1rem;
		color: var(--rafDarkBlue);
		margin-bottom: 0.5rem;
	}

	.activity-card p {
		font-size: 0.88rem;
		color: rgb(var(--gray-dark));
		line-height: 1.5;
		margin: 0;
	}

	/* Staff */
	.staff-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}

	.staff-card {
		background: rgba(229,233,240,0.4);
		border-radius: 8px;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--rafDarkBlue);
	}

	.staff-card-rank {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--rafRed);
		margin-bottom: 0.25rem;
	}

	.staff-card-name {
		font-size: 1rem;
		font-weight: 600;
		color: var(--rafDarkBlue);
	}

	.staff-card-bio {
		font-size: 0.85rem;
		color: rgb(var(--gray-dark));
		line-height: 1.5;
		margin: 0.4rem 0 0;
	}
</style>
