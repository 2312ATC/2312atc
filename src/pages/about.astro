---
import Page from '../layouts/Page.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import logo from '../assets/images/logo.jpg';

const staffEntry = await getEntry('staff', 'items');
const staffMembers = staffEntry?.data.items ?? [];

const offersEntry = await getEntry('offers', 'items');
const offers = offersEntry?.data.items ?? [];
---

<Page
	title="About Us | 2312 Squadron Air Cadets"
	description="Learn about 2312 (Tavistock) Squadron Air Cadets - our history, mission and the team behind the squadron."
	pageType="AboutPage"
	breadcrumbs={[
		{ name: 'Home', path: '/' },
		{ name: 'About', path: '/about' },
	]}
>
	<div class="hero-banner">
		<h1>About 2312 Squadron</h1>
		<p>Proudly serving Tavistock and the surrounding area since 1957</p>
	</div>

	<div class="page-content">
		<nav aria-label="Breadcrumb" class="breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">About</span>
		</nav>

		<!-- Mission / intro -->
		<section aria-labelledby="about-mission-heading" class="about-section about-intro">
			<div class="about-intro-text">
				<h2 id="about-mission-heading" class="section-heading">Who We Are</h2>
				<p>
					2312 (Tavistock) Squadron is a unit of the <strong>Royal Air Force Air Cadets (RAFAC)</strong> - one of the UK's largest and most respected youth organisations, with over 40,000 cadets nationwide. We are part of Plymouth and Cornwall Wing, Royal Air Force Air Cadets.
				</p>
				<p>
					Our squadron provides young people aged 12 to 20 with an outstanding range of activities and opportunities that develop self-confidence, leadership, teamwork and, life skills in a fun, safe environment with a strong connection to aviation and the RAF.
				</p>
				<p>
					Whether a cadet is interested in flying, shooting, music, sport, community service, or simply making new friends - there is something for everyone at 2312 Squadron.
				</p>
			</div>
			<div class="about-intro-logo">
				<Image src={logo} alt="2312 Squadron Royal Air Force Air Cadets badge" width={280} height={280} />
			</div>
		</section>

		<hr class="rule" />

		<!-- What we offer -->
		<section aria-labelledby="about-activities-heading" class="about-section">
			<h2 id="about-activities-heading" class="section-heading">What We Offer</h2>
			<div class="activities-grid">
				{offers.map((offer) => (
					<div class="activity-card">
						<span class="material-icons activity-icon" aria-hidden="true">{offer.icon}</span>
						<h3>{offer.title}</h3>
						<p>{offer.description}</p>
					</div>
				))}
			</div>
		</section>

		<hr class="rule" />

		<!-- History -->
		<section aria-labelledby="about-history-heading" class="about-section">
			<h2 id="about-history-heading" class="section-heading">Our History</h2>
			<div class="prose-content">
				<p>
					2312 Squadron was formed in <strong>1957</strong> after the Second World War as part of the Air Training Corps, which was originally established to prepare young men for service in the RAF and other armed services; with women joining in the 1980s.
				</p>
				<p>
					Over six decades later, the squadron continues to thrive in Tavistock, serving the young people of the town and the surrounding Devon countryside. The squadron has a proud record of sending cadets on to careers in the RAF and other armed services, as well as aviation, engineering and many other fields.
				</p>
				<p>
					Today we are part of the <strong>Royal Air Force Air Cadets</strong>, which has over 1,000 squadrons across the United Kingdom and international crown dependencies and is overseen by Air Commodore Al Lewis, with our local unit part of the Plymouth and Cornwall Wing.
				</p>
			</div>
		</section>

		<hr class="rule" />

		<!-- Staff -->
		<section aria-labelledby="about-staff-heading" class="about-section">
			<h2 id="about-staff-heading" class="section-heading">Our Staff</h2>
			<p style="color:var(--color-body); margin-bottom:1.5rem;">
				Our squadron is run by a team of dedicated volunteers: Civilian Instructors and uniformed Cadet Force Adult Volunteers.
			</p>
			<div class="staff-grid">
				{staffMembers.map((member) => (
					<div class="staff-card">
						<div class="staff-card-rank">{member.role}</div>
						<div class="staff-card-name">{member.name}</div>
						{member.bio && <p class="staff-card-bio">{member.bio}</p>}
					</div>
				))}
			</div>
			<p style="margin-top:1.25rem;">
				<a href="/contact" class="btn btn-primary">Get in touch with the squadron</a>
			</p>
		</section>
	</div>
</Page>

<style>
	.about-section {
		margin-bottom: 0.5rem;
	}

	/* Intro with logo */
	.about-intro {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: start;
	}

	.about-intro-logo img {
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		max-width: 220px;
		background: var(--color-raf-navy);
		padding: 10px;
	}

	@media (max-width: 640px) {
		.about-intro {
			grid-template-columns: 1fr;
		}
		.about-intro-logo {
			text-align: center;
		}
	}

	.about-intro-text p {
		color: var(--color-body);
		line-height: var(--leading-prose);
		margin-bottom: 1rem;
	}

	/* Activities grid */
	.activities-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.25rem;
		margin-top: 1.5rem;
	}

	.activity-card {
		background: var(--color-white);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		padding: 1.25rem;
		text-align: center;
		border-top: 3px solid var(--color-raf-red);
	}

	.activity-icon {
		font-size: 2rem;
		color: var(--color-raf-navy);
		margin-bottom: 0.5rem;
		display: block;
	}

	.activity-card h3 {
		font-size: 1rem;
		color: var(--color-raf-navy);
		margin-bottom: 0.5rem;
	}

	.activity-card p {
		font-size: 0.88rem;
		color: var(--color-body);
		line-height: var(--leading-copy);
		margin: 0;
	}

	/* Staff */
	.staff-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}

	.staff-card {
		background: var(--color-line-40);
		border-radius: var(--radius-lg);
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--color-raf-navy);
	}

	.staff-card-rank {
		font-size: 0.75rem;
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		color: var(--color-raf-red);
		margin-bottom: 0.25rem;
	}

	.staff-card-name {
		font-size: 1rem;
		font-weight: var(--font-weight-semibold);
		color: var(--color-raf-navy);
	}

	.staff-card-bio {
		font-size: 0.85rem;
		color: var(--color-body);
		line-height: var(--leading-copy);
		margin: 0.4rem 0 0;
	}
</style>
