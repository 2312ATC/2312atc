---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandingCarousel from '../components/LandingCarousel.astro';
import NotificationBanner from '../components/NotificationBanner.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const now = new Date();

const upcomingEvents = (await getCollection('events'))
	.filter((e) => e.data.date >= now)
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
	.slice(0, 3);

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />

		<main id="main-content">
			<NotificationBanner />
			<LandingCarousel />

			<!-- About intro -->
			<section class="home-about" aria-labelledby="home-about-heading">
				<div class="page-content" style="text-align:center; max-width:820px; padding-top:3rem; padding-bottom:2.5rem;">
					<p class="home-about-eyebrow">Royal Air Force Air Cadets</p>
					<h1 id="home-about-heading" class="home-about-title">Welcome to 2312 Squadron</h1>
					<p class="home-about-body">
						Based in Tavistock, Devon, 2312 Squadron is part of the Royal Air Force Air Cadets — one of the UK's largest youth organisations. We give young people aged 12–20 the opportunity to develop confidence, leadership and teamwork skills, whilst enjoying aviation, adventure training and much more.
					</p>
					<div class="home-cta-group">
						<a href="/join" class="btn btn-primary">Join Us</a>
						<a href="/about" class="btn btn-outline">About the Squadron</a>
					</div>
				</div>
			</section>

			<!-- Stats strip -->
			<div class="stats-strip" aria-label="Squadron at a glance">
				<div class="stat">
					<span class="stat-number">70+</span>
					<span class="stat-label">Active Cadets</span>
				</div>
				<div class="stat">
					<span class="stat-number">1944</span>
					<span class="stat-label">Founded</span>
				</div>
				<div class="stat">
					<span class="stat-number">Tue &amp; Thu</span>
					<span class="stat-label">Parade Nights</span>
				</div>
				<div class="stat">
					<span class="stat-number">12–20</span>
					<span class="stat-label">Age Range</span>
				</div>
			</div>

			<!-- Upcoming Events -->
			{upcomingEvents.length > 0 && (
				<section class="home-section" aria-labelledby="events-heading">
					<div class="page-content">
						<div class="section-header">
							<h2 id="events-heading" class="section-heading">Upcoming Events</h2>
							<a href="/events" class="section-view-all">View all events →</a>
						</div>
						<div class="event-strip">
							{upcomingEvents.map((event) => (
								<article class="event-card" aria-label={event.data.title}>
									<div class="event-card-date" aria-label={`Date: ${event.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}`}>
										<span class="event-card-day">{event.data.date.getDate()}</span>
										<span class="event-card-month">{event.data.date.toLocaleString('en-GB', { month: 'short' })}</span>
									</div>
									<div class="event-card-info">
										<h3 class="event-card-title">
											<a href={`/events/${event.id}/`}>{event.data.title}</a>
										</h3>
										<p class="event-card-location">
											<span class="material-icons" aria-hidden="true" style="font-size:0.9em;vertical-align:middle;">location_on</span>
											{event.data.location}
										</p>
										<p class="event-card-desc">{event.data.description}</p>
									</div>
								</article>
							))}
						</div>
					</div>
				</section>
			)}

			<!-- Latest News -->
			{latestPosts.length > 0 && (
				<section class="home-section home-section--alt" aria-labelledby="news-heading">
					<div class="page-content">
						<div class="section-header">
							<h2 id="news-heading" class="section-heading">Latest News</h2>
							<a href="/blog" class="section-view-all">All news →</a>
						</div>
						<div class="card-grid">
							{latestPosts.map((post) => (
								<article class="card">
									{post.data.heroImage && (
										<a href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
											<img
												src={post.data.heroImage.src}
												alt=""
												class="card-img"
												loading="lazy"
												width="640"
												height="300"
											/>
										</a>
									)}
									<div class="card-body">
										<p class="card-meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="card-title">
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</h3>
										<p class="card-description">{post.data.description}</p>
									</div>
									<div class="card-footer">
										<a href={`/blog/${post.id}/`} class="btn btn-outline" style="font-size:0.85rem;padding:0.4rem 1rem;">Read more</a>
									</div>
								</article>
							))}
						</div>
					</div>
				</section>
			)}

			<!-- Join CTA banner -->
			<section class="join-cta" aria-labelledby="join-cta-heading">
				<div class="page-content" style="text-align:center; padding-top:3rem; padding-bottom:3rem;">
					<h2 id="join-cta-heading" style="color:#fff; font-size:clamp(1.5rem,3vw,2.25rem); margin-bottom:0.75rem;">
						Ready to take to the skies?
					</h2>
					<p style="color:rgba(255,255,255,0.85); max-width:560px; margin:0 auto 1.75rem; font-size:1.05rem;">
						If you're aged 12–20 and looking for adventure, friendship and new skills — Air Cadets is for you. Come along to a parade night and see for yourself.
					</p>
					<a href="/join" class="btn btn-primary" style="font-size:1.1rem;padding:0.75rem 2rem;">Find out how to join</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* About intro */
	.home-about {
		background: #fff;
	}

	.home-about-eyebrow {
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--rafRed);
		margin-bottom: 0.5rem;
	}

	.home-about-title {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		color: var(--rafDarkBlue);
		margin-bottom: 1rem;
	}

	.home-about-body {
		font-size: 1.1rem;
		color: rgb(var(--gray-dark));
		line-height: 1.7;
		margin-bottom: 1.75rem;
	}

	.home-cta-group {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Stats strip */
	.stats-strip {
		background: var(--rafDarkBlue);
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		text-align: center;
		padding: 1.5rem 1.25rem;
		gap: 1rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		color: #fff;
	}

	.stat-number {
		font-size: clamp(1.3rem, 3vw, 2rem);
		font-weight: 800;
		color: #fff;
		line-height: 1.1;
	}

	.stat-label {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.7);
	}

	@media (max-width: 480px) {
		.stats-strip {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Section scaffold */
	.home-section {
		background: #fff;
		padding: 0.5rem 0 1.5rem;
	}

	.home-section--alt {
		background: rgb(var(--gray-light), 0.35);
		background: rgba(229,233,240,0.35);
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.section-view-all {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--rafRed);
		text-decoration: none;
		white-space: nowrap;
	}
	.section-view-all:hover { text-decoration: underline; }

	/* Event strip on homepage */
	.event-strip {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.event-card {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		padding: 1.25rem;
		background: #fff;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		border-left: 4px solid var(--rafRed);
		transition: transform 0.15s ease;
	}

	.event-card:hover {
		transform: translateX(3px);
	}

	.event-card-date {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 3rem;
		text-align: center;
		background: var(--rafDarkBlue);
		color: #fff;
		border-radius: 6px;
		padding: 0.4rem 0.5rem;
		flex-shrink: 0;
	}

	.event-card-day {
		font-size: 1.6rem;
		font-weight: 800;
		line-height: 1;
	}

	.event-card-month {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		opacity: 0.85;
	}

	.event-card-title {
		font-size: 1.05rem;
		color: var(--rafDarkBlue);
		margin-bottom: 0.2rem;
	}

	.event-card-title a {
		text-decoration: none;
		color: inherit;
	}

	.event-card-title a:hover { color: var(--rafRed); text-decoration: underline; }

	.event-card-location {
		font-size: 0.82rem;
		color: rgb(var(--gray));
		margin-bottom: 0.3rem;
	}

	.event-card-desc {
		font-size: 0.9rem;
		color: rgb(var(--gray-dark));
		margin: 0;
		line-height: 1.5;
	}

	/* Blog card image */
	.card-img {
		width: 100%;
		height: 180px;
		object-fit: cover;
	}

	/* Join CTA */
	.join-cta {
		background: linear-gradient(135deg, var(--rafDarkBlue) 0%, var(--rafLightBlue) 100%);
		position: relative;
		overflow: hidden;
	}

	.join-cta::before {
		content: '';
		position: absolute;
		top: 0; right: 0; bottom: 0;
		width: 6px;
		background: var(--rafRed);
	}
</style>
