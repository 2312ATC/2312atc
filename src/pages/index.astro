---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandingCarousel from '../components/LandingCarousel.astro';
import NotificationBanner from '../components/NotificationBanner.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const buildId = import.meta.env.PUBLIC_BUILD_ID ?? '';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />

		<main id="main-content">
			<div class="home-hero">
				<LandingCarousel />
				<NotificationBanner overlay />
			</div>

			<!-- About intro -->
			<section class="home-about" aria-labelledby="home-about-heading">
				<div class="page-content">
					<p class="home-about-eyebrow">Royal Air Force Air Cadets</p>
					<h1 id="home-about-heading" class="home-about-title">Welcome to 2312 Squadron</h1>
					<p class="home-about-body">
						Based in Tavistock, Devon, 2312 Squadron is part of the Royal Air Force Air Cadets - one of the UK's largest youth organisations. We give young people aged 12–20 the opportunity to develop confidence, leadership and teamwork skills, whilst enjoying aviation, adventure training and much more.
					</p>
					<div class="home-cta-group">
						<a href="/join" class="btn btn-primary">Join Us</a>
						<a href="/about" class="btn btn-outline">About the Squadron</a>
					</div>
				</div>
			</section>

			<!-- Stats strip -->
			<div class="stats-strip" aria-label="Squadron at a glance">
				<div class="stat">
					<span class="stat-number">40+</span>
					<span class="stat-label">Active Cadets</span>
				</div>
				<div class="stat">
					<span class="stat-number">1957</span>
					<span class="stat-label">Founded</span>
				</div>
				<div class="stat">
					<span class="stat-number">Tue &amp; Thu</span>
					<span class="stat-label">Parade Nights</span>
				</div>
				<div class="stat">
					<span class="stat-number">12–20</span>
					<span class="stat-label">Age Range</span>
				</div>
			</div>

			<!-- Upcoming Events (loaded at view time) -->
			<section class="home-section" aria-labelledby="events-heading" data-build-id={buildId}>
				<div class="page-content">
					<div class="section-header">
						<h2 id="events-heading" class="section-heading">Upcoming Events</h2>
						<a href="/events" class="section-view-all">View all events →</a>
					</div>
					<div
						id="home-events-list"
						class="event-strip"
						aria-live="polite"
						aria-busy="true"
					></div>
				</div>
			</section>

			<!-- Latest News -->
			{latestPosts.length > 0 && (
				<section class="home-section home-section--alt" aria-labelledby="news-heading">
					<div class="page-content">
						<div class="section-header">
							<h2 id="news-heading" class="section-heading">Latest News</h2>
							<a href="/blog/page/1" class="section-view-all">All news →</a>
						</div>
						<div class="card-grid">
							{latestPosts.map((post) => (
								<article class="card">
									{post.data.heroImage && (
										<a href={`/blog/${post.id}`} tabindex="-1">
											<Image
												src={post.data.heroImage}
												alt={post.data.description}
												class="card-img"
												width={640}
												height={300}
												loading="lazy"
											/>
										</a>
									)}
									<div class="card-body">
										<p class="card-meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="card-title">
											<a href={`/blog/${post.id}`}>{post.data.title}</a>
										</h3>
										<p class="card-description">{post.data.description}</p>
									</div>
									<div class="card-footer">
										<a href={`/blog/${post.id}`} class="btn btn-outline" style="font-size:0.85rem;padding:0.4rem 1rem;">Read more</a>
									</div>
								</article>
							))}
						</div>
					</div>
				</section>
			)}

			<!-- Join CTA banner -->
			<section class="join-cta band" aria-labelledby="join-cta-heading">
				<div class="page-content page-content--roomy">
					<h2 id="join-cta-heading" class="band-title home-cta-title">
						Ready to take to the skies?
					</h2>
					<p class="band-copy band-copy--measure">
						If you're aged 12–20 and looking for adventure, friendship and new skills - Air Cadets is for you. Come along to a parade night and see for yourself.
					</p>
					<a href="/join" class="btn btn-primary btn-lg">Find out how to join</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.home-hero {
		position: relative;
	}

	/* About intro */
	.home-about .page-content {
		text-align: center;
		max-width: var(--measure-intro);
		padding-top: 3rem;
		padding-bottom: var(--space-section);
	}

	.home-about-eyebrow {
		font-size: 0.85rem;
		font-weight: var(--font-weight-bold);
		letter-spacing: var(--tracking-caps);
		text-transform: uppercase;
		color: var(--color-raf-red);
		margin-bottom: 0.5rem;
	}

	.home-about-title {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		color: var(--color-raf-navy);
		margin-bottom: 1rem;
	}

	.home-about-body {
		font-size: 1.1rem;
		color: var(--color-body);
		line-height: 1.7;
		margin-bottom: 1.75rem;
	}

	.home-cta-group {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Stats strip */
	.stats-strip {
		background: var(--color-raf-navy);
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		text-align: center;
		padding: 1.5rem 1.25rem;
		gap: 1rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		color: var(--color-white);
	}

	.stat-number {
		font-size: clamp(1.3rem, 3vw, 2rem);
		font-weight: var(--font-weight-extrabold);
		color: var(--color-white);
		line-height: 1.1;
	}

	.stat-label {
		font-size: 0.78rem;
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-white-70);
	}

	@media (max-width: 480px) {
		.stats-strip {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Section scaffold */
	.home-section {
		background: var(--color-white);
		padding: 0.5rem 0 1.5rem;
	}

	.home-section--alt {
		background: var(--color-line-35);
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.section-view-all {
		font-size: 0.9rem;
		font-weight: var(--font-weight-semibold);
		color: var(--color-raf-red);
		text-decoration: none;
		white-space: nowrap;
	}
	.section-view-all:hover { text-decoration: underline; }

	/* Event strip on homepage */
	.event-strip {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	/* :global - cards are built in client script, so scoped attrs are not applied */
	:global(.event-card) {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		padding: 1.25rem;
		background: var(--color-white);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		border-left: 4px solid var(--color-raf-red);
		transition: transform var(--duration-fast) ease;
	}

	:global(.event-card:hover) {
		transform: translateX(var(--nudge));
	}

	:global(.event-card-date) {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 3rem;
		text-align: center;
		background: var(--color-raf-navy);
		color: var(--color-white);
		border-radius: var(--radius-md);
		padding: 0.4rem 0.5rem;
		flex-shrink: 0;
	}

	:global(.event-card-day) {
		font-size: 1.6rem;
		font-weight: var(--font-weight-extrabold);
		line-height: 1;
	}

	:global(.event-card-month) {
		font-size: 0.7rem;
		font-weight: var(--font-weight-semibold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-meta);
		opacity: 0.85;
	}

	:global(.event-card-title) {
		font-size: 1.05rem;
		color: var(--color-raf-navy);
		margin-bottom: 0.2rem;
	}

	:global(.event-card-title a) {
		text-decoration: none;
		color: inherit;
	}

	:global(.event-card-title a:hover) { color: var(--color-raf-red); text-decoration: underline; }

	:global(.event-card-location) {
		font-size: 0.82rem;
		color: var(--color-muted);
		margin-bottom: 0.3rem;
	}

	:global(.event-card-desc) {
		font-size: 0.9rem;
		color: var(--color-body);
		margin: 0;
		line-height: var(--leading-copy);
	}

	/* Blog card image */
	.card-img {
		width: 100%;
		height: 180px;
		object-fit: cover;
	}

	/* Join CTA */
	.join-cta {
		position: relative;
		overflow: hidden;
	}

	.home-cta-title {
		font-size: clamp(1.5rem, 3vw, 2.25rem);
	}
</style>

<script>
	interface CalEvent {
		id: string;
		title: string;
		date: string;
		endDate: string | null;
		location: string;
		description: string;
		url: string;
	}

	const listEl = document.getElementById('home-events-list')!;
	const sectionEl = listEl.closest<HTMLElement>('[data-build-id]')!;
	const buildId = sectionEl.dataset.buildId ?? '';

	function buildCard(e: CalEvent): HTMLElement {
		const d = new Date(e.date);
		const day = d.getDate();
		const mon = d.toLocaleString('en-GB', { month: 'short' });
		const dateLabel = d.toLocaleDateString('en-GB', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
		});

		const card = document.createElement('article');
		card.className = 'event-card';
		card.setAttribute('aria-label', e.title);
		card.innerHTML = `
			<div class="event-card-date" aria-label="Date: ${dateLabel}">
				<span class="event-card-day">${day}</span>
				<span class="event-card-month">${mon}</span>
			</div>
			<div class="event-card-info">
				<h3 class="event-card-title">
					<a href="${e.url}">${e.title}</a>
				</h3>
				<p class="event-card-location">
					<span class="material-icons" aria-hidden="true" style="font-size:0.9em;vertical-align:middle;">location_on</span>
					${e.location}
				</p>
				<p class="event-card-desc">${e.description}</p>
			</div>
		`;
		return card;
	}

	function showEmpty() {
		listEl.innerHTML = '';
		const empty = document.createElement('p');
		empty.className = 'empty-note';
		empty.textContent = 'No events to display.';
		listEl.appendChild(empty);
	}

	async function loadUpcomingEvents() {
		try {
			const query = buildId ? `?v=${encodeURIComponent(buildId)}` : '';
			const res = await fetch(`/api/events/upcoming.json${query}`, { cache: 'no-store' });
			if (!res.ok) throw new Error('Failed to load events');

			const { events } = (await res.json()) as { events: CalEvent[] };
			const now = new Date();
			now.setHours(0, 0, 0, 0)

			const upcoming = (events ?? [])
				.filter((e) => new Date(e.date) >= now)
				.sort((a, b) => new Date(a.date).valueOf() - new Date(b.date).valueOf())
				.slice(0, 3);

			listEl.innerHTML = '';

			if (upcoming.length === 0) {
				showEmpty();
				return;
			}

			upcoming.forEach((e) => listEl.appendChild(buildCard(e)));
		} catch {
			showEmpty();
		} finally {
			listEl.setAttribute('aria-busy', 'false');
		}
	}

	loadUpcomingEvents();
</script>
