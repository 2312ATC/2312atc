---
import Page from '../layouts/Page.astro';
import { getEntry } from 'astro:content';

const opportunitiesEntry = await getEntry('opportunities', 'items');
const opportunitiesList = opportunitiesEntry?.data.items ?? [];

const linksEntry = await getEntry('cadetLinks', 'items');
const usefulLinks = linksEntry?.data.items ?? [];
---

<Page
	title="For Cadets | 2312 Squadron Air Cadets"
	description="Resources, training information and useful links for current cadets at 2312 Squadron."
	breadcrumbs={[
		{ name: 'Home', path: '/' },
		{ name: 'For Cadets', path: '/cadets' },
	]}
>
	<div class="hero-banner">
		<h1>For Cadets</h1>
		<p>Resources, training and information for current members of 2312 Squadron</p>
	</div>

	<div class="page-content">
		<nav aria-label="Breadcrumb" class="breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">For Cadets</span>
		</nav>

		<!-- Training syllabus -->
		<section aria-labelledby="cadets-training" class="cadets-section">
			<h2 id="cadets-training" class="section-heading">Training Syllabus</h2>
			<p style="color:var(--color-body); margin-bottom:1.5rem;">
				The Air Cadet training programme is structured into levels from First Class through to Master Cadet. Each stage develops new skills and knowledge across a range of subjects.
			</p>
			<div class="training-grid">
				<div class="training-card">
					<div class="training-card-badge">Level 1</div>
					<h3>First Class</h3>
					<p>Introduction to Air Cadet life: drill, uniform, RAF history, and basic aviation knowledge.</p>
				</div>
				<div class="training-card">
					<div class="training-card-badge">Level 2</div>
					<h3>Leading Cadet</h3>
					<p>Expanding knowledge of aviation, navigation, first aid, and leadership fundamentals.</p>
				</div>
				<div class="training-card">
					<div class="training-card-badge">Level 3</div>
					<h3>Senior Cadet</h3>
					<p>Advanced aviation theory, meteorology, communications and continued leadership development.</p>
				</div>
				<div class="training-card">
					<div class="training-card-badge">Level 4</div>
					<h3>Master Cadet</h3>
					<p>The highest training classification - covering complex aviation topics, expedition leadership and BTEC modules.</p>
				</div>
			</div>
		</section>

		<hr class="rule" />

		<!-- Opportunities -->
		<section aria-labelledby="cadets-opportunities" class="cadets-section">
			<h2 id="cadets-opportunities" class="section-heading">Opportunities</h2>
			<ul class="opportunities-list">
				{opportunitiesList.map((opp) => (
					<li>
						<span class="material-icons" aria-hidden="true">{opp.icon}</span>
						<div>
							<strong>{opp.title}</strong>
							<span>{opp.description}</span>
						</div>
					</li>
				))}
			</ul>
		</section>
		<hr class="rule" />

		<!-- Useful links -->
		<section aria-labelledby="cadets-links" class="cadets-section">
			<h2 id="cadets-links" class="section-heading">Useful Links</h2>
			<div class="links-grid">
				{usefulLinks.map((link) => (
					<a
						href={link.url}
						class="link-card"
						{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						<span class="material-icons" aria-hidden="true">{link.icon}</span>
						<span>{link.label}</span>
					</a>
				))}
			</div>
		</section>
	</div>
</Page>

<style>
	.cadets-section { margin-bottom: 0.5rem; }

	/* Training cards */
	.training-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1rem;
	}

	.training-card {
		background: var(--color-white);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		padding: 1.25rem;
		border-top: 3px solid var(--color-raf-navy);
	}

	.training-card-badge {
		display: inline-block;
		background: var(--color-raf-red);
		color: var(--color-white);
		font-size: 0.7rem;
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-tight);
		margin-bottom: 0.5rem;
	}

	.training-card h3 { font-size: 1rem; color: var(--color-raf-navy); margin-bottom: 0.35rem; }
	.training-card p { font-size: 0.88rem; color: var(--color-body); margin: 0; line-height: var(--leading-copy); }

	/* Opportunities */
	.opportunities-list {
		list-style: none;
		padding: 0;
		margin-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.opportunities-list li {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1rem 1.25rem;
		background: var(--color-line-35);
		border-radius: var(--radius-lg);
	}

	.opportunities-list .material-icons {
		color: var(--color-raf-red);
		font-size: 1.4rem;
		flex-shrink: 0;
		margin-top: 1px;
	}

	.opportunities-list div {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.opportunities-list strong {
		font-size: 0.95rem;
		color: var(--color-raf-navy);
	}

	.opportunities-list span {
		font-size: 0.88rem;
		color: var(--color-body);
	}

	/* Links grid */
	.links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1rem;
		margin-top: 1.25rem;
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.25rem;
		background: var(--color-white);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		text-decoration: none;
		color: var(--color-raf-navy);
		font-weight: var(--font-weight-semibold);
		font-size: 0.92rem;
		transition: background var(--duration-fast), color var(--duration-fast);
		border: 2px solid transparent;
	}

	.link-card:hover {
		background: var(--color-raf-navy);
		color: var(--color-white);
		border-color: var(--color-raf-navy);
	}

	.link-card .material-icons { font-size: 1.1rem; flex-shrink: 0; }
</style>
