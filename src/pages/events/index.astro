---
import Page from '../../layouts/Page.astro';
import EventCalendar from '../../components/EventCalendar.astro';
---

<Page title="Events | 2312 Squadron Air Cadets" description="Upcoming events and activities at 2312 Squadron Air Cadets, Tavistock.">
	<div class="hero-banner">
		<h1>Events</h1>
		<p>Upcoming activities, competitions and adventures for 2312 Squadron</p>
	</div>

	<div class="page-content">
		<!-- Calendar with built-in month navigation and fetch -->
		<section aria-labelledby="cal-section-label" class="events-cal-section">
			<h2 id="cal-section-label" class="sr-only">Events Calendar</h2>
			<EventCalendar />
		</section>

		<!-- Events list for the selected month - driven by calendar:monthchange -->
		<section aria-labelledby="month-events-heading" class="month-events-section">
			<h2 id="month-events-heading" class="section-heading month-events-title">
				<!-- filled by script -->
			</h2>
			<div
				id="month-events-list"
				class="events-list-grid"
				aria-live="polite"
				aria-atomic="true"
			>
				<!-- filled by script -->
			</div>
		</section>
	</div>
</Page>

<style>
	.events-cal-section  { margin-bottom: 2.5rem; }
	.month-events-section { padding-bottom: 3rem; }
	.month-events-title   { margin-bottom: 1.25rem; min-height: 2rem; }

	.events-list-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
		min-height: 4rem;
		align-items: stretch;
	}

	.events-empty {
		color: rgb(var(--gray));
		font-style: italic;
		padding: 1.5rem;
		background: rgba(229,233,240,0.4);
		border-radius: 8px;
		text-align: center;
		grid-column: 1 / -1;
	}

	/* :global - cards are built in client script, so scoped attrs are not applied */
	:global(.js-event-card) {
		background: #fff;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	:global(.js-event-card:hover) {
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(96,115,159,0.4);
	}
	:global(.js-event-card__body) {
		display: flex;
		gap: 1rem;
		padding: 1.25rem;
		flex: 1;
		min-height: 0;
		align-items: stretch;
	}
	:global(.js-event-card__date) {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		background: var(--rafDarkBlue);
		color: #fff;
		border-radius: 6px;
		padding: 0.5rem 0.65rem;
		flex-shrink: 0;
		height: fit-content;
		min-width: 3.25rem;
	}
	:global(.js-event-card__day) {
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1;
		font-family: 'League Spartan', system-ui, sans-serif;
	}
	:global(.js-event-card__mon) {
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		opacity: 0.85;
	}
	:global(.js-event-card__content) {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}
	:global(.js-event-card__title) {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--rafDarkBlue);
		margin: 0 0 0.3rem;
		font-family: 'League Spartan', system-ui, sans-serif;
	}
	:global(.js-event-card__title a) { text-decoration: none; color: inherit; }
	:global(.js-event-card__title a:hover) { color: var(--rafRed); text-decoration: underline; }
	:global(.js-event-card__meta) {
		font-size: 0.82rem;
		color: rgb(96,115,159);
		margin: 0 0 0.4rem;
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}
	:global(.js-event-card__meta .material-icons) { font-size: 0.95em; vertical-align: middle; }
	:global(.js-event-card__desc) {
		font-size: 0.9rem;
		color: rgb(34,41,57);
		line-height: 1.5;
		margin: 0;
	}
	:global(.js-event-card__footer) {
		margin-top: auto;
		padding: 0.75rem 1.25rem;
		background: rgba(229,233,240,0.4);
		border-top: 1px solid rgb(229,233,240);
	}
</style>

<script>
	const MONTH_NAMES = [
		'January','February','March','April','May','June',
		'July','August','September','October','November','December'
	];

	interface CalEvent {
		id: string;
		title: string;
		date: string;
		endDate: string | null;
		location: string;
		description: string;
		url: string;
	}

	const listEl  = document.getElementById('month-events-list')!;
	const titleEl = document.querySelector<HTMLElement>('.month-events-title')!;

	function buildCard(e: CalEvent): HTMLElement {
		const d   = new Date(e.date);
		const day = d.getDate();
		const mon = d.toLocaleString('en-GB', { month: 'short' });

		const card = document.createElement('article');
		card.className = 'js-event-card';
		card.setAttribute('aria-label', e.title);
		card.innerHTML = `
			<div class="js-event-card__body">
				<div class="js-event-card__date" aria-hidden="true">
					<span class="js-event-card__day">${day}</span>
					<span class="js-event-card__mon">${mon}</span>
				</div>
				<div class="js-event-card__content">
					<h3 class="js-event-card__title"><a href="${e.url}">${e.title}</a></h3>
					<p class="js-event-card__meta">
						<span class="material-icons" aria-hidden="true">location_on</span>
						${e.location}
					</p>
					<p class="js-event-card__desc">${e.description}</p>
				</div>
			</div>
			<div class="js-event-card__footer">
				<a href="${e.url}" class="btn btn-secondary" style="font-size:0.85rem;padding:0.4rem 1rem;">View details</a>
			</div>
		`;
		return card;
	}

	document.addEventListener('calendar:monthchange', (raw: Event) => {
		const { year, month, events } = (raw as CustomEvent<{
			year: number;
			month: number;
			events: CalEvent[];
		}>).detail;

		titleEl.textContent = `Events in ${MONTH_NAMES[month]} ${year}`;
		listEl.innerHTML = '';

		if (events.length === 0) {
			const empty = document.createElement('p');
			empty.className = 'events-empty';
			empty.textContent = `No events scheduled for ${MONTH_NAMES[month]} ${year}.`;
			listEl.appendChild(empty);
			return;
		}

		events
			.sort((a, b) => new Date(a.date).valueOf() - new Date(b.date).valueOf())
			.forEach((e) => listEl.appendChild(buildCard(e)));
	});
</script>
