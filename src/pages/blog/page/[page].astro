---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`News & Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			<div class="hero-banner">
				<h1>News &amp; Blog</h1>
				<p>Latest updates, news and stories from 2312 Squadron</p>
			</div>

			<div class="page-content">
				<nav aria-label="Breadcrumb" class="breadcrumb">
					<a href="/">Home</a>
					<span aria-hidden="true">›</span>
					<span aria-current="page">Blog</span>
				</nav>

				{page.data.length > 0 ? (
					<>
						<div class="blog-grid">
							{page.data.map((post, i) => {
								const isFeatured = i === 0 && page.currentPage === 1;
								const hero = post.data.heroImage;
								const isPortrait = hero && hero.height > hero.width;
								const media = hero && (
									<a
										href={`/blog/${post.id}/`}
										class="blog-card-media"
										tabindex="-1"
										aria-hidden="true"
									>
										<Image
											src={hero}
											alt=""
											class:list={[
												'blog-card-img',
												{ 'blog-card-img--portrait': isPortrait, 'blog-card-img--landscape': !isPortrait },
											]}
											width={hero.width}
											height={hero.height}
											loading={i === 0 ? 'eager' : 'lazy'}
										/>
									</a>
								);
								const content = (
									<div class="blog-card-content">
										<div class="card-body">
											<p class="card-meta">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<h2 class="card-title">
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											</h2>
											<p class="card-description">{post.data.description}</p>
										</div>
										<div class="card-footer">
											<a href={`/blog/${post.id}/`} class="btn btn-secondary blog-card-btn">
												Read more <span aria-hidden="true">→</span>
											</a>
										</div>
									</div>
								);
								return (
									<article class:list={['card', 'blog-card', { 'blog-card--featured': isFeatured }]}>
										{isFeatured ? (
											<>
												{content}
												{media}
											</>
										) : (
											<>
												{media}
												{content}
											</>
										)}
									</article>
								);
							})}
						</div>

						<nav class="pagination" aria-label="Blog pagination">
							{page.currentPage > 1 && (
								<a href="/blog/page/1" class="pagination-btn">⇐ Newest</a>
							)}
							{page.url.prev && (
								<a href={page.url.prev} class="pagination-btn">← Newer</a>
							)}
							<span class="pagination-info" aria-current="page">
								Page {page.currentPage} of {page.lastPage}
							</span>
							{page.url.next && (
								<a href={page.url.next} class="pagination-btn">Older →</a>
							)}
						</nav>
					</>
				) : (
					<p class="blog-empty">No posts yet. Check back soon!</p>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.blog-card {
		min-width: 0;
	}

	.blog-card-content {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}

	.blog-card-media {
		display: block;
		line-height: 0;
		overflow: hidden;
		background: rgb(var(--gray-light));
	}

	.blog-card:not(.blog-card--featured) .blog-card-media {
		aspect-ratio: 16 / 9;
	}

	.blog-card-img {
		width: 100%;
		height: 100%;
		display: block;
		object-position: center;
	}

	.blog-card-img--landscape {
		object-fit: cover;
	}

	.blog-card-img--portrait {
		object-fit: contain;
	}

	.blog-card .card-title a {
		color: inherit;
		text-decoration: none;
	}

	.blog-card .card-title a:hover {
		text-decoration: underline;
	}

	.blog-card .card-description {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.blog-card-btn {
		font-size: 0.85rem;
		padding: 0.45rem 1.1rem;
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	/* Featured first post: image left, content right (content first in DOM for row sizing) */
	.blog-card--featured {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: minmax(240px, 42%) 1fr;
		align-items: stretch;
		min-height: 0;
	}

	.blog-card--featured .blog-card-media {
		grid-column: 1;
		grid-row: 1;
		min-height: 0;
		min-width: 0;
	}

	.blog-card--featured .blog-card-content {
		grid-column: 2;
		grid-row: 1;
	}

	@media (min-width: 901px) {
		/*
		 * Absolute positioning keeps tall images out of grid flow so the content
		 * column sets the row height (min-height: 0 alone is not enough for <img>).
		 */
		.blog-card--featured .blog-card-media {
			position: relative;
			height: 100%;
		}

		.blog-card--featured .blog-card-img {
			position: absolute;
			inset: 0;
			margin: auto;
			min-height: 0;
			min-width: 0;
		}

		.blog-card--featured .blog-card-img--landscape {
			width: 100%;
			height: 100%;
			margin: 0;
		}

		.blog-card--featured .blog-card-img--portrait {
			width: auto;
			height: auto;
			max-width: 100%;
			max-height: 100%;
		}
	}

	.blog-card--featured .card-body {
		padding: 2rem 2rem 1rem;
	}

	.blog-card--featured .card-title {
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		line-height: 1.25;
	}

	.blog-card--featured .card-description {
		-webkit-line-clamp: 4;
		font-size: 1rem;
	}

	.blog-card--featured .card-footer {
		padding: 0 2rem 2rem;
		background: transparent;
		border-top: none;
		margin-top: auto;
	}

	@media (max-width: 900px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.blog-card--featured {
			grid-template-columns: 1fr;
		}

		.blog-card--featured .blog-card-media {
			grid-row: 1;
			grid-column: 1;
			height: auto;
			aspect-ratio: 16 / 9;
		}

		.blog-card--featured .blog-card-content {
			grid-row: 2;
			grid-column: 1;
		}
	}

	@media (max-width: 560px) {
		.blog-grid {
			grid-template-columns: 1fr;
		}
	}

	.blog-empty {
		color: rgb(var(--gray));
		font-style: italic;
		padding: 2rem;
		background: rgba(229,233,240,0.4);
		border-radius: 8px;
		text-align: center;
	}

	/* Pagination */
	.pagination {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		padding: 2rem 0;
		flex-wrap: wrap;
	}

	.pagination-btn {
		padding: 0.5rem 1.1rem;
		border: 2px solid var(--rafDarkBlue);
		border-radius: 4px;
		text-decoration: none;
		color: var(--rafDarkBlue);
		font-weight: 600;
		font-size: 0.9rem;
		transition: background 0.15s, color 0.15s;
	}

	.pagination-btn:hover {
		background: var(--rafDarkBlue);
		color: #fff;
	}

	.pagination-info {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-weight: 600;
	}
</style>
