---
import { SQUADRON_ADDRESS } from '../consts';
import Page from '../layouts/Page.astro';
import { getEntry } from 'astro:content';

const faqEntry = await getEntry('faq', 'items');
const faqItems = faqEntry?.data.items ?? [];
---

<Page
	title="Join Us | 2312 Squadron Air Cadets"
	description="Find out how to join 2312 Squadron Air Cadets in Tavistock. Open to young people aged 12–20."
	breadcrumbs={[
		{ name: 'Home', path: '/' },
		{ name: 'Join Us', path: '/joinUs' },
	]}
>
	<div class="hero-banner">
		<h1>Join the Air Cadets</h1>
		<p>Start your adventure with 2312 Squadron today</p>
	</div>

	<div class="page-content">
		<nav aria-label="Breadcrumb" class="breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">Join Us</span>
		</nav>

		<!-- Eligibility -->
		<section aria-labelledby="join-eligibility" class="join-section">
			<h2 id="join-eligibility" class="section-heading">Am I Eligible?</h2>
			<div class="eligibility-grid">
				<div class="eligibility-card eligibility-card--yes">
					<span class="material-icons" aria-hidden="true">check_circle</span>
					<h3>You can join if you are:</h3>
					<ul>
						<li>Aged <strong>12 (year 8) to 17</strong> to join as a cadet</li>
						<li>Living in or near <strong>Tavistock, Devon</strong></li>
						<li>Ready to attend parade nights regularly</li>
						<li>Interested in aviation, adventure or team activities</li>
					</ul>
				</div>
				<div class="eligibility-card eligibility-card--info">
					<span class="material-icons" aria-hidden="true">info</span>
					<h3>For adults (18+):</h3>
					<ul>
						<li>You can apply to become a <strong>Cadet Force Adult Volunteer (CFAV)</strong></li>
						<li>You can join as a <strong>Civilian Instructor (CI)</strong> or choose to go into uniform</li>
						<li>No military background required</li>
						<li>Full training and DBS checks provided</li>
					</ul>
				</div>
			</div>
			<div class="squadron-finder">
				<p>Use the RAFAC Squadron Finder and search for "Tavistock".</p>
				<p>
					<a
						href="https://www.raf.mod.uk/aircadets/"
						class="btn btn-primary"
						target="_blank"
						rel="noopener noreferrer"
					>
						Visit RAF Air Cadets Squadron Finder
					</a>
				</p>
			</div>
		</section>

		<hr class="rule" />

		<!-- Parade nights -->
		<section aria-labelledby="join-parades" class="join-section">
			<h2 id="join-parades" class="section-heading">Parade Nights</h2>
			<div class="parade-info">
				<div class="parade-detail">
					<span class="material-icons" aria-hidden="true">event</span>
					<div>
						<strong>Tuesday &amp; Thursday</strong>
						<span>Tuesday 18:45 - 21:30<br>Thursday 19:00 - 21:00</span>
					</div>
				</div>
				<div class="parade-detail">
					<span class="material-icons" aria-hidden="true">location_on</span>
					<div>
						<strong>{SQUADRON_ADDRESS}</strong>
					</div>
				</div>
			</div>
		</section>

		<hr class="rule" />

		<!-- What to expect -->
		<section aria-labelledby="join-expect" class="join-section">
			<h2 id="join-expect" class="section-heading">What to Expect</h2>
			<ol class="join-steps">
				<li class="join-step">
					<div class="join-step-num" aria-hidden="true">1</div>
					<div>
						<h3>Get in touch</h3>
						<p>Contact us by email or come along to a parade night. We'll answer all your questions and arrange a visit.</p>
					</div>
				</li>
				<li class="join-step">
					<div class="join-step-num" aria-hidden="true">2</div>
					<div>
						<h3>Come for a visit</h3>
						<p>Watch a parade night in your own clothes - no uniform needed. Meet the cadets and staff and see what we get up to.</p>
					</div>
				</li>
				<li class="join-step">
					<div class="join-step-num" aria-hidden="true">3</div>
					<div>
						<h3>Complete the paperwork</h3>
						<p>We'll give you the joining forms to complete with your parent or guardian. These include consent forms and a brief medical questionnaire.</p>
					</div>
				</li>
				<li class="join-step">
					<div class="join-step-num" aria-hidden="true">4</div>
					<div>
						<h3>Get your uniform &amp; get started!</h3>
						<p>Once you join, you'll be issued your uniform and begin your cadet training. Welcome to 2312 Squadron!</p>
					</div>
				</li>
			</ol>
		</section>

		<hr class="rule" />

		<!-- FAQs -->
		<section aria-labelledby="join-faq" class="join-section">
			<h2 id="join-faq" class="section-heading">Frequently Asked Questions</h2>
			<div class="faq-list">
				{faqItems.map((item) => (
					<details class="faq-item">
						<summary>{item.question}</summary>
						<div class="faq-answer faq-prose" set:html={item.bodyHtml} />
					</details>
				))}
			</div>
		</section>

		<!-- CTA -->
		<div class="join-cta-box band band--inset">
			<h2>Ready to join?</h2>
			<p>Send us a message and we'll get back to you within a few days.</p>
			<a href="/contact" class="btn btn-primary btn-lg">Enquire about joining</a>
		</div>
	</div>
</Page>

<style>
	.join-section { margin-bottom: 0.5rem; }

	.eligibility-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
		margin-top: 1.25rem;
	}

	.eligibility-card {
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.eligibility-card--yes {
		background: var(--color-success-soft);
		border-left: 5px solid var(--color-success-accent);
	}
	.eligibility-card--yes .material-icons { color: var(--color-success); font-size: 1.6rem; }

	.eligibility-card--info {
		background: var(--color-info-soft);
		border-left: 5px solid var(--color-info-accent);
	}
	.eligibility-card--info .material-icons { color: var(--color-info); font-size: 1.6rem; }

	.eligibility-card h3 { font-size: 1rem; color: var(--color-raf-navy); margin: 0; }
	.eligibility-card ul { margin: 0; padding-left: 1.25rem; }
	.eligibility-card li { font-size: 0.92rem; margin-bottom: 0.3rem; color: var(--color-body); }

	.squadron-finder {
		text-align: center;
		margin-top: 1.5rem;
	}

	.squadron-finder p {
		color: var(--color-body);
		margin: 0;
	}

	.squadron-finder p + p {
		margin-top: 1rem;
	}

	/* Parade info */
	.parade-info {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1.25rem;
	}

	.parade-detail {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		background: var(--color-line-40);
		border-radius: var(--radius-lg);
		padding: 1rem 1.25rem;
		flex: 1;
		min-width: 220px;
	}

	.parade-detail .material-icons {
		color: var(--color-raf-red);
		font-size: 1.4rem;
		flex-shrink: 0;
	}

	.parade-detail div {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.parade-detail strong { color: var(--color-raf-navy); font-size: 1rem; }
	.parade-detail span { font-size: 0.9rem; color: var(--color-body); }

	/* Steps */
	.join-steps {
		list-style: none;
		padding: 0;
		margin-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.join-step {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.join-step-num {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--color-raf-red);
		color: var(--color-white);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
		font-weight: var(--font-weight-extrabold);
		flex-shrink: 0;
	}

	.join-step h3 { font-size: 1rem; color: var(--color-raf-navy); margin-bottom: 0.25rem; }
	.join-step p { font-size: 0.92rem; color: var(--color-body); margin: 0; line-height: var(--leading-copy); }

	/* FAQs */
	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.faq-item {
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.faq-item summary {
		padding: 1rem 1.25rem;
		font-weight: var(--font-weight-semibold);
		color: var(--color-raf-navy);
		cursor: pointer;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: var(--color-line-30);
	}

	.faq-item summary::-webkit-details-marker { display: none; }

	.faq-item summary::after {
		content: '+';
		font-size: 1.2rem;
		color: var(--color-raf-red);
		font-weight: var(--font-weight-bold);
		flex-shrink: 0;
	}

	.faq-item[open] summary::after { content: '−'; }

	.faq-item:focus-within summary {
		outline: var(--focus-ring);
		outline-offset: var(--focus-offset-tight);
	}

	.faq-answer {
		padding: 1rem 1.25rem;
		border-top: 1px solid var(--color-line);
	}

	.faq-answer p { font-size: 0.92rem; color: var(--color-body); margin: 0; line-height: var(--leading-body); }

	.faq-prose :global(p) { font-size: 0.92rem; color: var(--color-body); margin: 0 0 0.5rem; line-height: var(--leading-body); }
	.faq-prose :global(p:last-child) { margin-bottom: 0; }
	.faq-prose :global(a) { color: var(--color-raf-navy); }
	.faq-prose :global(strong) { color: var(--color-raf-navy); }

	/* CTA box */
	.join-cta-box {
		margin-top: 3rem;
	}
</style>
