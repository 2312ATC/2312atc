---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { blogPostGitDates } from '../lib/gitHistory';
import { blogPostingNode, canonicalUrlFromPath } from '../lib/jsonLd';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, heroImage } = Astro.props;
const siteURL = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = canonicalUrlFromPath(Astro.url.pathname, siteURL);
const imageUrl = heroImage ? new URL(heroImage.src, siteURL).href : undefined;
const { published, updated } = blogPostGitDates(canonicalURL.pathname.slice('/blog/'.length));
const showUpdated = published && updated && updated.getTime() > published.getTime();
const jsonLd = [
	blogPostingNode({
		url: canonicalURL.href,
		headline: title,
		description,
		datePublished: published,
		dateModified: updated,
		imageUrl,
		siteOrigin: siteURL.origin,
	}),
];


// Approximate reading time
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${title} | 2312 Squadron`}
			description={description}
			image={heroImage}
			ogType="article"
			jsonLd={jsonLd}
			breadcrumbs={[
				{ name: 'Home', path: '/' },
				{ name: 'Blog', path: '/blog/page/1' },
				{ name: title, path: canonicalURL.pathname },
			]}
		/>
	</head>

	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main-content">
			{heroImage ? (
				<div class="blog-hero">
					<Image
						src={heroImage}
						alt=""
						class="blog-hero-img"
						width={1400}
						height={500}
						loading="eager"
					/>
					<div class="blog-hero-overlay">
						<div class="blog-hero-content">
							<nav aria-label="Breadcrumb" class="breadcrumb breadcrumb--on-dark">
								<a href="/">Home</a>
								<span aria-hidden="true">›</span>
								<a href="/blog/page/1">Blog</a>
								<span aria-hidden="true">›</span>
								<span aria-current="page">{title}</span>
							</nav>
						</div>
					</div>
				</div>
			) : (
				<div class="hero-banner">
					<nav aria-label="Breadcrumb" class="breadcrumb breadcrumb--on-dark">
						<a href="/">Home</a>
						<span aria-hidden="true">›</span>
						<a href="/blog/page/1">Blog</a>
						<span aria-hidden="true">›</span>
						<span aria-current="page">{title}</span>
					</nav>
				</div>
			)}

			<div class="page-content">
				{!heroImage && (
					<nav aria-label="Breadcrumb" class="breadcrumb">
						<a href="/">Home</a>
						<span aria-hidden="true">›</span>
						<a href="/blog/page/1">Blog</a>
						<span aria-hidden="true">›</span>
						<span aria-current="page">{title}</span>
					</nav>
				)}

				<article class="blog-article" aria-label={title}>
					<header class="blog-header">
						<div class="blog-meta">
							{published && <FormattedDate date={published} />}
							{showUpdated && updated && (
								<span class="blog-updated">
									· Updated <FormattedDate date={updated} />
								</span>
							)}
						</div>
						<h1 class="blog-title">{title}</h1>
						<p class="blog-description">{description}</p>
					</header>

					<div class="prose-content blog-prose">
						<slot />
					</div>

					<footer class="blog-footer">
						<a href="/blog/page/1" class="btn btn-outline">← Back to Blog</a>
					</footer>
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-hero {
		position: relative;
		width: 100%;
		max-height: 440px;
		overflow: hidden;
	}

	.blog-hero-img {
		width: 100%;
		height: 440px;
		object-fit: cover;
		display: block;
	}

	.blog-hero-overlay {
		position: absolute;
		inset: 0;
		background: var(--gradient-scrim-soft);
		display: flex;
		align-items: flex-end;
		padding-bottom: 1.5rem;
	}

	.blog-hero-content {
		width: 100%;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 var(--space-page-x);
	}

	/* Article layout */
	.blog-article {
		max-width: var(--measure-width);
		margin: 0 auto;
		padding: 2rem 0 3rem;
	}

	.blog-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 2px solid var(--color-line);
	}

	.blog-meta {
		font-size: 0.85rem;
		color: var(--color-muted);
		margin-bottom: 0.75rem;
		font-weight: var(--font-weight-semibold);
	}

	.blog-updated {
		font-style: italic;
		font-weight: var(--font-weight-normal);
	}

	.blog-title {
		font-size: clamp(1.6rem, 4vw, 2.4rem);
		color: var(--color-raf-navy);
		margin-bottom: 0.75rem;
		line-height: var(--leading-heading);
	}

	.blog-description {
		font-size: 1.1rem;
		color: var(--color-muted);
		line-height: var(--leading-body);
		font-style: italic;
		margin: 0;
	}

	.blog-prose {
		margin-bottom: 2.5rem;
	}

	.blog-footer {
		padding-top: 1.5rem;
		border-top: 2px solid var(--color-line);
	}
</style>
